+/***********************************************************************
+ *              WINTRUST_SIPPAddAppxProvider
+ *
+ * AppX and MSIX packages. Windows registers these from AppxSip.dll; here the
+ * same functions are wintrust's own, and the package is recognised by contents
+ * rather than by magic number, since every ZIP file starts the same way.
+ */
+static BOOL WINTRUST_SIPPAddAppxProvider(void)
+{
+    SIP_ADD_NEWPROVIDER NewProv;
+    BOOL Ret;
+
+    memset(&NewProv, 0, sizeof(SIP_ADD_NEWPROVIDER));
+    NewProv.cbStruct = sizeof(SIP_ADD_NEWPROVIDER);
+    NewProv.pwszDLLFileName = wcsdup(SP_POLICY_PROVIDER_DLL_NAME);
+    NewProv.pgSubject              = (GUID *)&appx_sip_guid;
+    NewProv.pwszIsFunctionName     = (WCHAR *)L"AppxSipIsFileSupported";
+    NewProv.pwszGetFuncName        = (WCHAR *)L"CryptSIPGetSignedDataMsg";
+    NewProv.pwszPutFuncName        = (WCHAR *)L"CryptSIPPutSignedDataMsg";
+    NewProv.pwszCreateFuncName     = (WCHAR *)L"CryptSIPCreateIndirectData";
+    NewProv.pwszVerifyFuncName     = (WCHAR *)L"CryptSIPVerifyIndirectData";
+    NewProv.pwszRemoveFuncName     = (WCHAR *)L"CryptSIPRemoveSignedDataMsg";
+
+    Ret = CryptSIPAddProvider(&NewProv);
+
+    free(NewProv.pwszDLLFileName);
+
+    return Ret;
+}
