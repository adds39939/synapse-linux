+/* Razer's devices are configured with 90-byte feature reports:
+ *
+ *   [0] status  [1] transaction id  [2-3] remaining packets  [4] protocol type
+ *   [5] data size  [6] command class  [7] command id  [8-87] arguments  [88] crc  [89] reserved
+ *
+ * where the crc is the XOR of bytes 2 to 87.
+ *
+ * Command 0x00/0x04 sets the device mode, and 0x00/0x84 reads it back. In driver mode
+ * (0x03) a mouse stops applying the button assignments stored in it and reports raw
+ * keys instead, for Razer's filter driver to translate on the way up the input stack.
+ * Razer Synapse switches every RGB device into driver mode as it starts. Wine has no
+ * filter driver, and could not apply one's output outside Wine anyway, so in driver
+ * mode a remapped button sends its default key to the whole desktop. Keep the device in
+ * normal mode, where its own firmware applies the assignments Synapse stores in it, and
+ * report back the mode the application asked for, so that it does not keep asking.
+ * The RazerDriverMode bus option turns this off. */
+#define RAZER_REPORT_SIZE       90
+#define RAZER_NORMAL_MODE       0x00
+#define RAZER_DRIVER_MODE       0x03
+
+static BOOL is_razer_mode_report( const BYTE *report, unsigned int length, BYTE command )
+{
+    return length == RAZER_REPORT_SIZE && report[6] == 0x00 && report[7] == command;
+}
+
+static void razer_set_crc( BYTE *report )
+{
+    BYTE crc = 0;
+    unsigned int i;
+
+    for (i = 2; i < 88; i++) crc ^= report[i];
+    report[88] = crc;
+}
+
+/* a set device mode request on its way to the device */
+static void razer_set_mode( struct hidraw_device *impl, BYTE *report, unsigned int length )
+{
+    if (!impl->razer || !is_razer_mode_report( report, length, 0x04 )) return;
+
+    impl->razer_mode = report[8];
+    impl->razer_mode_param = report[9];
+    if (report[8] != RAZER_DRIVER_MODE) return;
+
+    TRACE( "keeping %s in normal mode instead of driver mode\n", debugstr_a(impl->base.devnode) );
+    report[8] = RAZER_NORMAL_MODE;
+    report[9] = 0;
+    razer_set_crc( report );
+}
+
+/* the device's answer to a set or get device mode request */
+static void razer_get_mode( struct hidraw_device *impl, BYTE *report, unsigned int length )
+{
+    if (!impl->razer) return;
+    if (!is_razer_mode_report( report, length, 0x04 ) && !is_razer_mode_report( report, length, 0x84 )) return;
+
+    /* Found in driver mode without having been asked for it here: left that way by a
+     * session that did not get to restore it, here or under Windows. Put it right, and
+     * carry on as if the application had asked for driver mode itself. */
+    if (report[7] == 0x84 && report[8] == RAZER_DRIVER_MODE && impl->razer_mode != RAZER_DRIVER_MODE)
+    {
+        BYTE request[1 + RAZER_REPORT_SIZE] = {0}, *set = request + 1;
+
+        set[1] = report[1];             /* the same transaction id */
+        set[5] = 2;
+        set[6] = 0x00;
+        set[7] = 0x04;
+        set[8] = RAZER_NORMAL_MODE;
+        razer_set_crc( set );
+        TRACE( "%s was left in driver mode, putting it back in normal mode\n", debugstr_a(impl->base.devnode) );
+        if (ioctl( impl->base.device_fd, HIDIOCSFEATURE(sizeof(request)), request ) > 0)
+        {
+            BYTE answer[1 + RAZER_REPORT_SIZE] = {0};
+            /* let the device finish with it before the application's next request */
+            usleep( 5000 );
+            ioctl( impl->base.device_fd, HIDIOCGFEATURE(sizeof(answer)), answer );
+            impl->razer_mode = RAZER_DRIVER_MODE;
+            impl->razer_mode_param = report[9];
+        }
+        return;
+    }
+
+    if (impl->razer_mode != RAZER_DRIVER_MODE) return;
+    if (report[8] != RAZER_NORMAL_MODE) return;
+
+    report[8] = RAZER_DRIVER_MODE;
+    report[9] = impl->razer_mode_param;
+    razer_set_crc( report );
+}
+
