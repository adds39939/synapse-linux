                                              IO_STATUS_BLOCK *io)
 {
@@ -407,6 +500,7 @@ static void hidraw_device_get_feature_report(struct unix_device *iface, HID_XFER
     {
         count = ioctl(impl->base.device_fd, HIDIOCGFEATURE(length + 1), buffer);
         memcpy(packet->reportBuffer, buffer + 1, length);
+        if (count > 0) razer_get_mode(impl, packet->reportBuffer, length);
     }
 
     if (count > 0)
@@ -442,6 +536,7 @@ static void hidraw_device_set_feature_report(struct unix_device *iface, HID_XFER
     else
     {
         memcpy(buffer + 1, packet->reportBuffer, length);
+        razer_set_mode(impl, buffer + 1, length);
         count = ioctl(impl->base.device_fd, HIDIOCSFEATURE(length + 1), buffer);
     }
 
@@ -1222,6 +1317,7 @@ static NTSTATUS hidraw_device_create(struct udev_device *dev, int fd, const char
 
     if (!(impl = raw_device_create(&hidraw_device_vtbl, sizeof(struct hidraw_device))))
         return STATUS_NO_MEMORY;
+    ((struct hidraw_device *)impl)->razer = desc.vid == 0x1532 && !options->razer_driver_mode;
     list_add_tail(&device_list, &impl->unix_device.entry);
     impl->read_report = hidraw_device_read_report;
     impl->udev_device = udev_device_ref(dev);
