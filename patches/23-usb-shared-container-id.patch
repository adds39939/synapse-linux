diff --git dlls/winebus.sys/bus_udev.c dlls/winebus.sys/bus_udev.c
index 35c3721..6c9ff6a 100644
--- dlls/winebus.sys/bus_udev.c
+++ dlls/winebus.sys/bus_udev.c
@@ -1171,6 +1171,24 @@ static void get_device_subsystem_info(struct udev_device *dev, const char *subsy
 
         if ((tmp = udev_device_get_sysattr_value(parent, "serial")))
             ntdll_umbstowcs(tmp, strlen(tmp) + 1, desc->serialnumber, ARRAY_SIZE(desc->serialnumber));
+
+        /* devpath is the chain of hub ports, "3" or "1.4"; with the bus it names the
+         * socket the device is in, which is what libusb tells wineusb.sys too. */
+        if ((tmp = udev_device_get_sysattr_value(parent, "busnum")))
+        {
+            const char *path = udev_device_get_sysattr_value(parent, "devpath");
+            UINT busnum = strtoul(tmp, NULL, 10), depth = 0;
+            UINT8 ports[8];
+            char *end;
+
+            while (path && *path && depth < ARRAY_SIZE(ports))
+            {
+                ports[depth++] = strtoul(path, &end, 10);
+                if (*end != '.') break;
+                path = end + 1;
+            }
+            usb_container_id(&desc->container_id, desc->vid, desc->pid, busnum, ports, depth);
+        }
     }
 }
 
