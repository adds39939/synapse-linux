+/* The container of a physical USB device: one GUID for every device node Windows would
+ * group under it -- the device, its interfaces, and the HID collections on them. It is
+ * derived from where the device is plugged in, so it is the same on every run, and
+ * wineusb.sys derives the identical GUID from libusb. The two must stay in step. */
+static inline void usb_container_id(GUID *guid, UINT vid, UINT pid, UINT busnum,
+                                    const UINT8 *ports, UINT depth)
+{
+    UINT i;
+
+    guid->Data1 = (vid << 16) | (pid & 0xffff);
+    guid->Data2 = busnum;
+    guid->Data3 = 0x5500 | depth;
+    for (i = 0; i < ARRAY_SIZE(guid->Data4); i++) guid->Data4[i] = i < depth ? ports[i] : 0;
+}
