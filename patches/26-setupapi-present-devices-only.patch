+/* Whether any of the device's interfaces under this class key is present. */
+static BOOL has_linked_interface(HKEY key)
+{
+    WCHAR name[MAX_PATH];
+    DWORD i, len;
+    HKEY subkey;
+    BOOL ret = FALSE;
+
+    for (i = 0; !ret; i++)
+    {
+        len = ARRAY_SIZE(name);
+        if (RegEnumKeyExW(key, i, name, &len, NULL, NULL, NULL, NULL)) break;
+        if (*name != '#' || RegOpenKeyExW(key, name, 0, KEY_READ, &subkey)) continue;
+        ret = is_linked(subkey);
+        RegCloseKey(subkey);
+    }
+    return ret;
+}
