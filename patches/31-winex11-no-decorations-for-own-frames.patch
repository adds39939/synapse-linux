@@ -694,6 +694,7 @@ struct x11drv_win_data
     UINT        parent_invalid : 1; /* is the parent host window possibly invalid */
     UINT        reparenting : 1; /* window is being reparented, likely from a decoration change */
     UINT        is_resizable : 1; /* window is allowed to be resized by the window manager */
+    UINT        custom_frame : 1; /* window draws its own frame, the window manager mustn't add one */
     Window      embedder;       /* window id of embedder */
     Pixmap         icon_pixmap;
     Pixmap         icon_mask;
diff --git include/wine/gdi_driver.h include/wine/gdi_driver.h
index 320850b..18d47ab 100644
--- include/wine/gdi_driver.h
+++ include/wine/gdi_driver.h
@@ -355,6 +355,7 @@ struct gdi_device_manager
 #define WINE_DM_UNSUPPORTED 0x80000000
 #define WINE_SWP_FULLSCREEN 0x80000000
 #define WINE_SWP_RESIZABLE  0x40000000
+#define WINE_SWP_CUSTOM_FRAME 0x20000000
 
 struct vulkan_driver_funcs;
 struct opengl_driver_funcs;
