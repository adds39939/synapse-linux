+/* the foreground process allowed the current process to set the foreground, with AllowSetForegroundWindow */
+static int is_current_process_foreground_allowed( struct desktop *desktop )
+{
+    return desktop->foreground_allowed == current->process->id || desktop->foreground_allowed == (process_id_t)-1;
+}
