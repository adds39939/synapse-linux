-        if (!is_current_process_foreground( desktop ) && queue->input && desktop->foreground_input &&
+        if (!is_current_process_foreground( desktop ) && !is_current_process_foreground_allowed( desktop ) &&
+            queue->input && desktop->foreground_input &&
             queue->input->user_time < desktop->foreground_input->user_time)
         {
             set_error( STATUS_ACCESS_DENIED );
             goto done;
         }
+        /* the permission is good for one foreground change */
+        if (is_current_process_foreground_allowed( desktop )) desktop->foreground_allowed = 0;
     }
 
     reply->previous = desktop->foreground_input ? desktop->foreground_input->shared->active : 0;
@@ -3822,6 +3831,23 @@ done:
 }
 
 
+/* allow a process to set the foreground window */
+DECL_HANDLER(allow_set_foreground_window)
+{
+    struct desktop *desktop;
+
+    if (!(desktop = get_thread_desktop( current, 0 ))) return;
+
+    /* only a process that could set the foreground itself can pass that on */
+    if (is_current_process_foreground( desktop ) || is_current_process_foreground_allowed( desktop ))
+        desktop->foreground_allowed = req->pid;
+    else
+        set_error( STATUS_ACCESS_DENIED );
+
+    release_object( desktop );
+}
+
+
 /* set the current thread focus window */
 DECL_HANDLER(set_focus_window)
 {
