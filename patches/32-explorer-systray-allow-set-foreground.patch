+/*******************************************************************
+ *		allow_set_foreground_window
+ */
+BOOL allow_set_foreground_window( DWORD pid )
+{
+    BOOL ret;
+
+    SERVER_START_REQ( allow_set_foreground_window )
+    {
+        req->pid = pid;
+        ret = !wine_server_call_err( req );
+    }
+    SERVER_END_REQ;
+
+    TRACE( "pid %04x -> ret %u\n", pid, ret );
+    return ret;
+}
+
 /*****************************************************************
  *           NtUserSetForegroundWindow  (win32u.@)
  */
