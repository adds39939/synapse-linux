diff --git dlls/winebus.sys/razer.c dlls/winebus.sys/razer.c
new file mode 100644
index 0000000..3ee5e11
--- /dev/null
+++ dlls/winebus.sys/razer.c
@@ -0,0 +1,628 @@
+/*
+ * Razer input filter emulation: the Razer Control Device
+ *
+ * Copyright 2026 adds39939
+ *
