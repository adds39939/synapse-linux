+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "winioctl.h"
+#include "hidusage.h"
+#include "ddk/wdm.h"
+#include "ddk/hidtypes.h"
+#include "wine/debug.h"
+#include "wine/list.h"
+#include "wine/unixlib.h"
+
+#include "unixlib.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(razer);
+
+/* See razer.h. One control device stands for one Razer USB device, as a raw device of the
+ * bus: no driver is installed for it. Its device ID and container ID are what Synapse's
+ * mapping engine goes by to tell which device it belongs to -- the PID in the interface
+ * path, and the container ID of the device's HID collections. */
+
+static const GUID razer_control_interface = {0xe3be005d, 0xd130, 0x4910, {0x88, 0xff, 0x09, 0xae, 0x02, 0xf6, 0x80, 0xe9}};
+
+#define RAZER_CLIENT_QUEUE 128
+
+struct razer_control;
+
+/* an open handle */
+struct razer_client
+{
+    struct list entry;
+    struct razer_control *control;
+    UINT subscriptions;                 /* RAZER_EVENT_* */
+    UINT redirects;                     /* the input types it has redirected, 1 << type */
+    LIST_ENTRY reads;                   /* pending IOCTL_RAZER_READ_EVENT */
+    UINT first, count;
+    struct razer_event events[RAZER_CLIENT_QUEUE];
+};
+
+struct razer_control
+{
+    struct list entry;
+    DEVICE_OBJECT *device;
+    UINT64 filter;
+    struct device_desc desc;
+    UNICODE_STRING link;
+    BOOL linked;                        /* among the bus' children */
+    BOOL removed;                       /* surprise removed or removed: no more requests */
+    BOOL deleted;                       /* removed, and its device object deleted */
+    UINT subscriptions;                 /* the last told to the Unix side */
+    struct list clients;
+};
+
+/* A control is freed once it is both removed and has no open handle left. Wine sends no
+ * IRP_MJ_CLEANUP, only IRP_MJ_CLOSE, and none at all for a handle still open when the
+ * device is deleted: such a handle's client is never freed. */
+
+static CRITICAL_SECTION razer_cs;
+static CRITICAL_SECTION_DEBUG razer_cs_debug =
+{
+    0, 0, &razer_cs,
+    { &razer_cs_debug.ProcessLocksList, &razer_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": razer_cs") }
+};
+static CRITICAL_SECTION razer_cs = { &razer_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct list controls = LIST_INIT(controls);
+
+static NTSTATUS filter_ioctl(struct razer_control *control, UINT code, const void *in, UINT in_size,
+                             void *out, UINT out_size, UINT *out_len)
+{
+    struct razer_ioctl_params params =
+    {
+        .filter = control->filter,
+        .code = code,
+        .in = in,
+        .in_size = in_size,
+        .out = out,
+        .out_size = out_size,
+    };
+    NTSTATUS status = WINE_UNIX_CALL(razer_ioctl, &params);
+    if (out_len) *out_len = params.out_len;
+    return status;
+}
+
+static struct razer_control *find_control(DEVICE_OBJECT *device)
+{
+    struct razer_control *control;
+
+    LIST_FOR_EACH_ENTRY(control, &controls, struct razer_control, entry)
+        if (control->device == device) return control;
+    return NULL;
+}
+
+/* tell the Unix side what the handles want, with razer_cs held */
+static void update_subscriptions(struct razer_control *control)
+{
+    struct razer_client *client;
+    UINT subscriptions = 0;
+
+    LIST_FOR_EACH_ENTRY(client, &control->clients, struct razer_client, entry)
+        subscriptions |= client->subscriptions;
+    if (subscriptions == control->subscriptions || control->removed) return;
+
+    TRACE("control %p subscriptions %#x\n", control, subscriptions);
+    control->subscriptions = subscriptions;
+    filter_ioctl(control, RAZER_SET_SUBSCRIPTIONS, &subscriptions, sizeof(subscriptions), NULL, 0, NULL);
+}
+
+NTSTATUS razer_control_create(DRIVER_OBJECT *driver, UINT64 filter, const struct device_desc *desc)
+{
+    struct razer_control *control;
+    DEVICE_OBJECT *device;
+    UNICODE_STRING nameW;
+    WCHAR name[64];
+    NTSTATUS status;
+
+    if (!(control = calloc(1, sizeof(*control)))) return STATUS_NO_MEMORY;
+
+    swprintf(name, ARRAY_SIZE(name), L"\\Device\\RZCONTROL#%I64x", filter);
+    RtlInitUnicodeString(&nameW, name);
+    if ((status = IoCreateDevice(driver, sizeof(control), &nameW, FILE_DEVICE_UNKNOWN, 0, FALSE, &device)))
+    {
+        ERR("failed to create a control device for %04x:%04x, status %#lx\n", desc->vid, desc->pid, status);
+        free(control);
+        return status;
+    }
+
+    *(struct razer_control **)device->DeviceExtension = control;
+    control->device = device;
+    control->filter = filter;
+    control->desc = *desc;
+    control->linked = TRUE;
+    list_init(&control->clients);
+
+    EnterCriticalSection(&razer_cs);
+    list_add_tail(&controls, &control->entry);
+    LeaveCriticalSection(&razer_cs);
+
+    TRACE("control %p for %04x:%04x, filter %#I64x\n", control, desc->vid, desc->pid, filter);
+    return STATUS_SUCCESS;
+}
+
+void razer_control_unlink(UINT64 filter)
+{
+    struct razer_control *control;
+
+    EnterCriticalSection(&razer_cs);
+    LIST_FOR_EACH_ENTRY(control, &controls, struct razer_control, entry)
+        if (control->filter == filter) control->linked = FALSE;
+    LeaveCriticalSection(&razer_cs);
+}
+
+ULONG razer_control_count(void)
+{
+    struct razer_control *control;
+    ULONG count = 0;
+
+    EnterCriticalSection(&razer_cs);
+    LIST_FOR_EACH_ENTRY(control, &controls, struct razer_control, entry)
+        if (control->linked) count++;
+    LeaveCriticalSection(&razer_cs);
+    return count;
+}
+
+ULONG razer_control_get_relations(DEVICE_OBJECT **devices, ULONG count)
+{
+    struct razer_control *control;
+    ULONG i = 0;
+
+    EnterCriticalSection(&razer_cs);
+    LIST_FOR_EACH_ENTRY(control, &controls, struct razer_control, entry)
+        if (control->linked && i < count) devices[i++] = control->device;
+    LeaveCriticalSection(&razer_cs);
+    return i;
+}
+
+BOOL razer_is_control(DEVICE_OBJECT *device)
+{
+    BOOL ret;
+
+    if (device->DeviceType != FILE_DEVICE_UNKNOWN) return FALSE;
+    EnterCriticalSection(&razer_cs);
+    ret = find_control(device) != NULL;
+    LeaveCriticalSection(&razer_cs);
+    return ret;
+}
+
+static void WINAPI read_cancel_routine(DEVICE_OBJECT *device, IRP *irp)
+{
+    TRACE("cancel %p\n", irp);
+    IoReleaseCancelSpinLock(irp->CancelIrql);
+
+    EnterCriticalSection(&razer_cs);
+    RemoveEntryList(&irp->Tail.Overlay.ListEntry);
+    LeaveCriticalSection(&razer_cs);
+
+    irp->IoStatus.Status = STATUS_CANCELLED;
+    irp->IoStatus.Information = 0;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+}
+
+/* a pending read, with razer_cs held */
+static IRP *pop_read(struct razer_client *client)
+{
+    LIST_ENTRY *entry;
+    IRP *irp;
+
+    while ((entry = RemoveHeadList(&client->reads)) != &client->reads)
+    {
+        irp = CONTAINING_RECORD(entry, IRP, Tail.Overlay.ListEntry);
+        if (IoSetCancelRoutine(irp, NULL)) return irp;
+        /* being cancelled: the cancel routine completes it */
+        InitializeListHead(&irp->Tail.Overlay.ListEntry);
+    }
+    return NULL;
+}
+
+static void complete_reads(struct razer_client *client, NTSTATUS status)
+{
+    IRP *irp;
+
+    EnterCriticalSection(&razer_cs);
+    while ((irp = pop_read(client)))
+    {
+        LeaveCriticalSection(&razer_cs);
+        irp->IoStatus.Status = status;
+        irp->IoStatus.Information = 0;
+        IoCompleteRequest(irp, IO_NO_INCREMENT);
+        EnterCriticalSection(&razer_cs);
+    }
+    LeaveCriticalSection(&razer_cs);
+}
+
+void razer_control_event(UINT64 filter, const struct razer_event *event)
+{
+    struct razer_control *control;
+    struct razer_client *client;
+    IRP *irps[16];
+    UINT i, count = 0;
+
+    EnterCriticalSection(&razer_cs);
+    LIST_FOR_EACH_ENTRY(control, &controls, struct razer_control, entry)
+    {
+        if (control->filter != filter) continue;
+        LIST_FOR_EACH_ENTRY(client, &control->clients, struct razer_client, entry)
+        {
+            IRP *irp;
+
+            if (!(client->subscriptions & event->kind)) continue;
+            if (count < ARRAY_SIZE(irps) && (irp = pop_read(client)))
+            {
+                memcpy(irp->AssociatedIrp.SystemBuffer, event, sizeof(*event));
+                irp->IoStatus.Status = STATUS_SUCCESS;
+                irp->IoStatus.Information = sizeof(*event);
+                irps[count++] = irp;
+                continue;
+            }
+            if (client->count == RAZER_CLIENT_QUEUE)
+            {
+                WARN("client %p queue full, dropping an event\n", client);
+                client->first = (client->first + 1) % RAZER_CLIENT_QUEUE;
+                client->count--;
+            }
+            client->events[(client->first + client->count++) % RAZER_CLIENT_QUEUE] = *event;
+        }
+    }
+    LeaveCriticalSection(&razer_cs);
+
+    for (i = 0; i < count; i++) IoCompleteRequest(irps[i], IO_NO_INCREMENT);
+}
+
+static WCHAR *alloc_string(const WCHAR *str, SIZE_T len)
+{
+    WCHAR *dst;
+
+    if ((dst = ExAllocatePool(PagedPool, (len + 1) * sizeof(WCHAR))))
+    {
+        memcpy(dst, str, len * sizeof(WCHAR));
+        dst[len] = 0;
+    }
+    return dst;
+}
+
+static NTSTATUS query_id(struct razer_control *control, IRP *irp, BUS_QUERY_ID_TYPE type)
+{
+    const GUID *guid = &control->desc.container_id;
+    WCHAR buffer[MAX_PATH];
+    SIZE_T len = 0;
+
+    switch (type)
+    {
+    case BusQueryDeviceID:
+    case BusQueryHardwareIDs:
+        /* what RzDev_<pid>.sys names its control devices; Razer's RzCommon.sys only binds to
+         * them through a compatible ID, RAZER\DeviceContol, which is left out */
+        len = swprintf(buffer, ARRAY_SIZE(buffer), L"RZCONTROL\\VID_%04X&PID_%04X&MI_00",
+                       control->desc.vid, control->desc.pid) + 1;
+        if (type == BusQueryHardwareIDs) buffer[len++] = 0;
+        break;
+    case BusQueryCompatibleIDs:
+        buffer[len++] = 0;
+        break;
+    case BusQueryInstanceID:
+        len = swprintf(buffer, ARRAY_SIZE(buffer), L"%X&%X&%02X%02X%02X%02X%02X%02X%02X%02X",
+                       guid->Data2, guid->Data3, guid->Data4[0], guid->Data4[1], guid->Data4[2],
+                       guid->Data4[3], guid->Data4[4], guid->Data4[5], guid->Data4[6], guid->Data4[7]) + 1;
+        break;
+    case BusQueryContainerID:
+        len = swprintf(buffer, ARRAY_SIZE(buffer), L"{%08lX-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}",
+                       guid->Data1, guid->Data2, guid->Data3, guid->Data4[0], guid->Data4[1], guid->Data4[2],
+                       guid->Data4[3], guid->Data4[4], guid->Data4[5], guid->Data4[6], guid->Data4[7]) + 1;
+        break;
+    default:
+        return irp->IoStatus.Status;
+    }
+
+    if (!(irp->IoStatus.Information = (ULONG_PTR)alloc_string(buffer, len))) return STATUS_NO_MEMORY;
+    TRACE("control %p id %u %s\n", control, type, debugstr_w(buffer));
+    return STATUS_SUCCESS;
+}
+
+static void control_disable(struct razer_control *control)
+{
+    struct razer_client *client;
+    LIST_ENTRY irps, *entry;
+    IRP *irp;
+
+    InitializeListHead(&irps);
+    EnterCriticalSection(&razer_cs);
+    control->removed = TRUE;
+    LIST_FOR_EACH_ENTRY(client, &control->clients, struct razer_client, entry)
+        while ((irp = pop_read(client))) InsertTailList(&irps, &irp->Tail.Overlay.ListEntry);
+    LeaveCriticalSection(&razer_cs);
+
+    if (control->link.Buffer) IoSetDeviceInterfaceState(&control->link, FALSE);
+    while ((entry = RemoveHeadList(&irps)) != &irps)
+    {
+        irp = CONTAINING_RECORD(entry, IRP, Tail.Overlay.ListEntry);
+        irp->IoStatus.Status = STATUS_DELETE_PENDING;
+        irp->IoStatus.Information = 0;
+        IoCompleteRequest(irp, IO_NO_INCREMENT);
+    }
+}
+
+NTSTATUS razer_control_pnp(DEVICE_OBJECT *device, IRP *irp)
+{
+    IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation(irp);
+    struct razer_control *control = *(struct razer_control **)device->DeviceExtension;
+    NTSTATUS status = irp->IoStatus.Status;
+    DEVICE_CAPABILITIES *caps;
+    BOOL free_control;
+
+    TRACE("control %p, minor function %#x\n", control, irpsp->MinorFunction);
+
+    switch (irpsp->MinorFunction)
+    {
+    case IRP_MN_QUERY_ID:
+        status = query_id(control, irp, irpsp->Parameters.QueryId.IdType);
+        break;
+
+    case IRP_MN_QUERY_DEVICE_TEXT:
+        if (irpsp->Parameters.QueryDeviceText.DeviceTextType != DeviceTextDescription) break;
+        if (!(irp->IoStatus.Information = (ULONG_PTR)alloc_string(L"Razer Control Device", 20))) status = STATUS_NO_MEMORY;
+        else status = STATUS_SUCCESS;
+        break;
+
+    case IRP_MN_QUERY_CAPABILITIES:
+        caps = irpsp->Parameters.DeviceCapabilities.Capabilities;
+        caps->RawDeviceOK = 1;
+        caps->SilentInstall = 1;
+        caps->SurpriseRemovalOK = 1;
+        status = STATUS_SUCCESS;
+        break;
+
+    case IRP_MN_START_DEVICE:
+        status = STATUS_SUCCESS;
+        if (!control->link.Buffer &&
+            (status = IoRegisterDeviceInterface(device, &razer_control_interface, NULL, &control->link)))
+            ERR("failed to register the control device interface, status %#lx\n", status);
+        else if ((status = IoSetDeviceInterfaceState(&control->link, TRUE)))
+            ERR("failed to enable the control device interface, status %#lx\n", status);
+        else
+            TRACE("control %p is %s\n", control, debugstr_w(control->link.Buffer));
+        break;
+
+    case IRP_MN_SURPRISE_REMOVAL:
+        control_disable(control);
+        status = STATUS_SUCCESS;
+        break;
+
+    case IRP_MN_REMOVE_DEVICE:
+        control_disable(control);
+
+        EnterCriticalSection(&razer_cs);
+        list_remove(&control->entry);
+        RtlFreeUnicodeString(&control->link);
+        control->deleted = TRUE;
+        free_control = list_empty(&control->clients);
+        LeaveCriticalSection(&razer_cs);
+
+        if (free_control) free(control);
+
+        irp->IoStatus.Status = STATUS_SUCCESS;
+        IoCompleteRequest(irp, IO_NO_INCREMENT);
+        IoDeleteDevice(device);
+        return STATUS_SUCCESS;
+
+    default:
+        break;
+    }
+
+    irp->IoStatus.Status = status;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+    return status;
+}
+
+static NTSTATUS complete(IRP *irp, NTSTATUS status, ULONG_PTR information)
+{
+    irp->IoStatus.Status = status;
+    irp->IoStatus.Information = information;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+    return status;
+}
+
+NTSTATUS WINAPI razer_dispatch_create(DEVICE_OBJECT *device, IRP *irp)
+{
+    IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation(irp);
+    struct razer_control *control;
+    struct razer_client *client;
+
+    EnterCriticalSection(&razer_cs);
+    if (device->DeviceType != FILE_DEVICE_UNKNOWN || !(control = find_control(device)))
+    {
+        LeaveCriticalSection(&razer_cs);
+        return complete(irp, STATUS_INVALID_DEVICE_REQUEST, 0);
+    }
+    if (control->removed || !(client = calloc(1, sizeof(*client))))
+    {
+        LeaveCriticalSection(&razer_cs);
+        return complete(irp, control->removed ? STATUS_DELETE_PENDING : STATUS_NO_MEMORY, 0);
+    }
+
+    client->control = control;
+    InitializeListHead(&client->reads);
+    list_add_tail(&control->clients, &client->entry);
+    irpsp->FileObject->FsContext = client;
+    LeaveCriticalSection(&razer_cs);
+
+    TRACE("control %p, client %p\n", control, client);
+    return complete(irp, STATUS_SUCCESS, 0);
+}
+
+NTSTATUS WINAPI razer_dispatch_close(DEVICE_OBJECT *device, IRP *irp)
+{
+    IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation(irp);
+    struct razer_client *client = irpsp->FileObject ? irpsp->FileObject->FsContext : NULL;
+    struct razer_control *control;
+    BOOL last, free_control = FALSE;
+
+    if (!client) return complete(irp, STATUS_SUCCESS, 0);
+    control = client->control;
+
+    TRACE("client %p\n", client);
+    complete_reads(client, STATUS_CANCELLED);
+
+    EnterCriticalSection(&razer_cs);
+    list_remove(&client->entry);
+    last = list_empty(&control->clients);
+    if (last && control->deleted) free_control = TRUE;
+    else if (last && !control->removed)
+    {
+        control->subscriptions = 0;
+        filter_ioctl(control, RAZER_RESET, NULL, 0, NULL, 0, NULL);
+    }
+    else if (!last) update_subscriptions(control);
+    LeaveCriticalSection(&razer_cs);
+
+    irpsp->FileObject->FsContext = NULL;
+    free(client);
+    if (free_control) free(control);
+    return complete(irp, STATUS_SUCCESS, 0);
+}
+
+static NTSTATUS read_event(struct razer_client *client, IRP *irp, ULONG out_size)
+{
+    if (out_size < sizeof(struct razer_event)) return complete(irp, STATUS_BUFFER_TOO_SMALL, 0);
+
+    EnterCriticalSection(&razer_cs);
+    if (client->control->removed)
+    {
+        LeaveCriticalSection(&razer_cs);
+        return complete(irp, STATUS_DELETE_PENDING, 0);
+    }
+    if (client->count)
+    {
+        memcpy(irp->AssociatedIrp.SystemBuffer, &client->events[client->first], sizeof(struct razer_event));
+        client->first = (client->first + 1) % RAZER_CLIENT_QUEUE;
+        client->count--;
+        LeaveCriticalSection(&razer_cs);
+        return complete(irp, STATUS_SUCCESS, sizeof(struct razer_event));
+    }
+
+    IoSetCancelRoutine(irp, read_cancel_routine);
+    if (irp->Cancel && IoSetCancelRoutine(irp, NULL))
+    {
+        LeaveCriticalSection(&razer_cs);
+        return complete(irp, STATUS_CANCELLED, 0);
+    }
+    InsertTailList(&client->reads, &irp->Tail.Overlay.ListEntry);
+    irp->IoStatus.Status = STATUS_PENDING;
+    IoMarkIrpPending(irp);
+    LeaveCriticalSection(&razer_cs);
+    return STATUS_PENDING;
+}
+
+/* which handles get which events, set per handle */
+static NTSTATUS subscribe(struct razer_client *client, UINT kind, const void *in, ULONG in_size)
+{
+    if (in_size < 1) return STATUS_INVALID_PARAMETER;
+
+    EnterCriticalSection(&razer_cs);
+    if (*(BYTE *)in) client->subscriptions |= kind;
+    else client->subscriptions &= ~kind;
+    TRACE("client %p subscriptions %#x\n", client, client->subscriptions);
+    update_subscriptions(client->control);
+    LeaveCriticalSection(&razer_cs);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS WINAPI razer_dispatch_ioctl(DEVICE_OBJECT *device, IRP *irp)
+{
+    IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation(irp);
+    struct razer_client *client = irpsp->FileObject ? irpsp->FileObject->FsContext : NULL;
+    ULONG code = irpsp->Parameters.DeviceIoControl.IoControlCode;
+    ULONG in_size = irpsp->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_size = irpsp->Parameters.DeviceIoControl.OutputBufferLength;
+    void *buffer = irp->AssociatedIrp.SystemBuffer;
+    struct razer_redirect redirect;
+    NTSTATUS status;
+    UINT out_len = 0;
+
+    if (!client) return complete(irp, STATUS_INVALID_DEVICE_REQUEST, 0);
+    if (client->control->removed) return complete(irp, STATUS_DELETE_PENDING, 0);
+    /* every request RzCommon.sys takes is METHOD_BUFFERED */
+    if ((code & 3) != METHOD_BUFFERED) return complete(irp, STATUS_INVALID_DEVICE_REQUEST, 0);
+
+    switch (code)
+    {
+    case IOCTL_RAZER_READ_EVENT:
+        return read_event(client, irp, out_size);
+
+    case IOCTL_RAZER_RECEIVE_HOOKS:
+        return complete(irp, subscribe(client, RAZER_EVENT_HOOK, buffer, in_size), 0);
+    case IOCTL_RAZER_RECEIVE_NOTIFY:
+        return complete(irp, subscribe(client, RAZER_EVENT_NOTIFY, buffer, in_size), 0);
+    case IOCTL_RAZER_RECEIVE_OTHER:
+        return complete(irp, subscribe(client, RAZER_EVENT_OTHER, buffer, in_size), 0);
+
+    case IOCTL_RAZER_SET_REDIRECT:
+        if (in_size < sizeof(redirect)) return complete(irp, STATUS_INVALID_PARAMETER, 0);
+        memcpy(&redirect, buffer, sizeof(redirect));
+        if (redirect.type >= 32) return complete(irp, STATUS_INVALID_PARAMETER, 0);
+        status = filter_ioctl(client->control, code, &redirect, sizeof(redirect), NULL, 0, NULL);
+        if (!status)
+        {
+            BYTE any;
+            EnterCriticalSection(&razer_cs);
+            if (redirect.enable) client->redirects |= 1u << redirect.type;
+            else client->redirects &= ~(1u << redirect.type);
+            any = !!client->redirects;
+            LeaveCriticalSection(&razer_cs);
+            status = subscribe(client, RAZER_EVENT_REDIRECT, &any, sizeof(any));
+        }
+        return complete(irp, status, 0);
+
+    case IOCTL_RAZER_IS_OPEN:
+        if (out_size < 1) return complete(irp, STATUS_BUFFER_TOO_SMALL, 0);
+        *(BYTE *)buffer = 1;
+        return complete(irp, STATUS_SUCCESS, 1);
+
+    case IOCTL_RAZER_GET_CONSUMER_STATE:
+        if (out_size < 256) return complete(irp, STATUS_BUFFER_TOO_SMALL, 0);
+        memset(buffer, 0, 256);
+        return complete(irp, STATUS_SUCCESS, 256);
+
+    case IOCTL_RAZER_SET_HOOKS_ENABLED:
+    case IOCTL_RAZER_SEND_INPUT:
+    case IOCTL_RAZER_ADD_HOOK:
+    case IOCTL_RAZER_FIND_HOOK:
+    case IOCTL_RAZER_REMOVE_HOOK:
+    case IOCTL_RAZER_GET_HOOK:
+        status = filter_ioctl(client->control, code, buffer, in_size, buffer, out_size, &out_len);
+        if (status) TRACE("ioctl %#lx, status %#lx\n", code, status);
+        return complete(irp, status, out_len);
+
+    default:
+        /* RzCommon.sys hands the rest to the device's own driver; those it does not know
+         * end up answered with nothing to say */
+        FIXME("unhandled ioctl %#lx, in %lu, out %lu\n", code, in_size, out_size);
+        if (buffer && out_size) memset(buffer, 0, out_size);
+        return complete(irp, STATUS_SUCCESS, out_size);
+    }
+}
diff --git dlls/winebus.sys/razer.h dlls/winebus.sys/razer.h
new file mode 100644
index 0000000..a3a2803
--- /dev/null
+++ dlls/winebus.sys/razer.h
@@ -0,0 +1,228 @@
+/*
+ * Razer input filter emulation, shared by winebus.sys and its Unix library
+ *
+ * Copyright 2026 adds39939
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINEBUS_RAZER_H
+#define __WINEBUS_RAZER_H
+
+/* On Windows, Razer Synapse puts a device in "driver mode", where its firmware no longer
+ * applies the button assignments stored in it and sends every button's default input
+ * instead, and remaps the device on the PC. Two kernel drivers make that possible:
+ * RzDev_<pid>.sys, a KMDF filter on the device's HID keyboard and mouse collections that
+ * sees each input before the system does, and RzCommon.sys, which gives applications a
+ * "Razer Control Device" per device to talk to it through. Synapse's mapping engine finds
+ * that device by its interface class and container ID, opens it, and asks for the inputs
+ * it remaps (hooks), for every input of a kind (redirection) or for copies of them
+ * (notification); the filter holds those back from the system and queues them as events.
+ * What the mapping engine makes of them it injects back through the same device.
+ *
+ * Wine cannot load either driver, and the input never passes through Wine anyway: the
+ * desktop reads it from the kernel's evdev nodes. So winebus provides the control device
+ * itself, with the same interface, and its Unix side does the filter's job on the evdev
+ * nodes: it grabs them while a client is listening, hands the client what it asked for,
+ * and passes everything else -- and everything injected -- on through uinput devices that
+ * copy the originals.
+ *
+ * The structures below are the ones RzCommon.sys exchanges with applications. */
+
+/* All METHOD_BUFFERED, FILE_ANY_ACCESS. */
+#define IOCTL_RAZER_SET_HOOKS_ENABLED   0x88883004  /* in: BYTE enable, default 1 */
+#define IOCTL_RAZER_READ_EVENT          0x88883018  /* out: struct razer_event, pends until there is one */
+#define IOCTL_RAZER_SET_REDIRECT        0x8888301c  /* in: struct razer_redirect */
+#define IOCTL_RAZER_SEND_INPUT          0x88883020  /* in: struct razer_send_input */
+#define IOCTL_RAZER_ADD_HOOK            0x88883024  /* in: struct razer_hook */
+#define IOCTL_RAZER_FIND_HOOK           0x88883028  /* in: struct razer_input, out: struct razer_hook */
+#define IOCTL_RAZER_REMOVE_HOOK         0x8888302c  /* in: struct razer_input */
+#define IOCTL_RAZER_GET_HOOK            0x88883030  /* in: UINT index, out: struct razer_hook */
+#define IOCTL_RAZER_RECEIVE_HOOKS       0x88883034  /* in: UINT enable, for this handle */
+#define IOCTL_RAZER_RECEIVE_NOTIFY      0x88883038  /* in: UINT enable, for this handle */
+#define IOCTL_RAZER_RECEIVE_OTHER       0x8888303c  /* in: UINT enable, for this handle */
+#define IOCTL_RAZER_GET_CONSUMER_STATE  0x88883108  /* out: BYTE[256], one per consumer key */
+#define IOCTL_RAZER_IS_OPEN             0x88883110  /* out: BYTE */
+
+/* Not RzCommon's: winebus' own, from the control device to the Unix side. */
+#define RAZER_SET_SUBSCRIPTIONS         0           /* in: UINT, the RAZER_EVENT_* any handle receives */
+#define RAZER_RESET                     1           /* the last handle is closed */
+
+/* the kind of an event, and what a handle receives */
+#define RAZER_EVENT_REDIRECT    0x01  /* every input of a redirected kind, held back */
+#define RAZER_EVENT_HOOK        0x02  /* an input a hook asked for, held back */
+#define RAZER_EVENT_NOTIFY      0x04  /* a copy of an input, which goes on to the system */
+#define RAZER_EVENT_OTHER       0x08
+
+/* what an input is */
+#define RAZER_INPUT_KEYBOARD    0x01  /* KEYBOARD_INPUT_DATA */
+#define RAZER_INPUT_MOUSE       0x02  /* MOUSE_INPUT_DATA */
+#define RAZER_INPUT_DKM         0x03  /* a Razer key, as KEYBOARD_INPUT_DATA */
+#define RAZER_INPUT_MOUSE_MOVE  0x04
+#define RAZER_INPUT_JOYSTICK_LEFT   0x05
+#define RAZER_INPUT_JOYSTICK_RIGHT  0x06
+#define RAZER_INPUT_JOYSTICK_BUTTON 0x07
+#define RAZER_INPUT_JOYSTICK_HAT    0x09
+#define RAZER_INPUT_DISPLAY     0x0a  /* consumer brightness up (0x6f) or down (0x70), 0 for none */
+#define RAZER_INPUT_CONSUMER    0x0b
+#define RAZER_INPUT_CONSUMER_REPORT 0x0c
+
+/* KEYBOARD_INPUT_DATA.Flags and MOUSE_INPUT_DATA, under names that do not clash with
+ * linux/input.h */
+#define RAZER_KEY_BREAK         0x0001
+#define RAZER_KEY_E0            0x0002
+#define RAZER_KEY_E1            0x0004
+#define RAZER_MOUSE_MOVE_ABSOLUTE   0x0001
+#define RAZER_MOUSE_VIRTUAL_DESKTOP 0x0002
+#define RAZER_MOUSE_LEFT_DOWN   0x0001
+#define RAZER_MOUSE_LEFT_UP     0x0002
+#define RAZER_MOUSE_RIGHT_DOWN  0x0004
+#define RAZER_MOUSE_RIGHT_UP    0x0008
+#define RAZER_MOUSE_MIDDLE_DOWN 0x0010
+#define RAZER_MOUSE_MIDDLE_UP   0x0020
+#define RAZER_MOUSE_BUTTON4_DOWN 0x0040
+#define RAZER_MOUSE_BUTTON4_UP  0x0080
+#define RAZER_MOUSE_BUTTON5_DOWN 0x0100
+#define RAZER_MOUSE_BUTTON5_UP  0x0200
+#define RAZER_MOUSE_WHEEL       0x0400
+#define RAZER_MOUSE_HWHEEL      0x0800
+
+/* the unit id of input the filter injected itself: hooks only see it if they ask for it */
+#define RAZER_UNIT_INJECTED     0xabcd
+
+/* modifier keys held, as the filter tracks them for hooks */
+#define RAZER_MOD_LSHIFT        0x0001
+#define RAZER_MOD_LCTRL         0x0002
+#define RAZER_MOD_LALT          0x0004
+#define RAZER_MOD_RSHIFT        0x0040
+#define RAZER_MOD_RCTRL         0x0080
+#define RAZER_MOD_RALT          0x0100
+
+#include "pshpack4.h"
+
+/* An input: KEYBOARD_INPUT_DATA or MOUSE_INPUT_DATA, whose ExtraInformation carries the
+ * modifier keys held. It starts a hook, and the payload of an event. */
+struct razer_input
+{
+    UINT reserved;
+    UINT type;                      /* RAZER_INPUT_* */
+    union
+    {
+        struct
+        {
+            USHORT unit_id;
+            USHORT make_code;
+            USHORT flags;
+            USHORT reserved;
+            UINT modifiers;
+        } keyboard;
+        struct
+        {
+            USHORT unit_id;
+            USHORT flags;
+            USHORT button_flags;
+            USHORT button_data;
+            UINT raw_buttons;
+            INT last_x;
+            INT last_y;
+            UINT modifiers;
+        } mouse;
+        BYTE raw[24];
+    };
+};
+
+#define RAZER_HOOK_SIZE  0x124
+#define RAZER_EVENT_SIZE 0x130
+
+/* What the application asks to have held back. The rest is the application's own. */
+struct razer_hook
+{
+    struct razer_input input;
+    BYTE data[RAZER_HOOK_SIZE - sizeof(struct razer_input)];
+};
+
+/* An event: for a hook, the hook with the input that matched it in its place. */
+struct razer_event
+{
+    UINT reserved[2];
+    UINT kind;                      /* RAZER_EVENT_* */
+    struct razer_hook hook;
+};
+
+struct razer_redirect
+{
+    UINT type;                      /* 1 keyboard, 2 mouse, 4 mouse movement */
+    UINT enable;
+};
+
+/* What the application injects, as if from the device. */
+struct razer_send_input
+{
+    UINT target;                    /* another control device's, or 0 */
+    UINT type;                      /* RAZER_INPUT_* */
+    union
+    {
+        struct
+        {
+            USHORT unit_id;
+            USHORT make_code;
+            USHORT flags;
+            USHORT reserved;
+            UINT extra;
+        } keyboard;
+        struct
+        {
+            USHORT unit_id;
+            USHORT flags;
+            USHORT button_flags;
+            USHORT button_data;
+            UINT raw_buttons;
+            INT last_x;
+            INT last_y;
+            UINT extra;
+        } mouse;
+        BYTE raw[24];
+    };
+};
+
+#include "poppack.h"
+
+C_ASSERT(sizeof(struct razer_input) == 0x20);
+C_ASSERT(sizeof(struct razer_hook) == RAZER_HOOK_SIZE);
+C_ASSERT(sizeof(struct razer_event) == RAZER_EVENT_SIZE);
+C_ASSERT(sizeof(struct razer_send_input) == 0x20);
+
+#ifndef WINE_UNIX_LIB
+
+/* razer.c: the control devices, for main.c */
+struct device_desc;
+struct _DRIVER_OBJECT;
+struct _DEVICE_OBJECT;
+struct _IRP;
+
+extern NTSTATUS razer_control_create(struct _DRIVER_OBJECT *driver, UINT64 filter, const struct device_desc *desc);
+extern void razer_control_unlink(UINT64 filter);
+extern void razer_control_event(UINT64 filter, const struct razer_event *event);
+extern ULONG razer_control_count(void);
+extern ULONG razer_control_get_relations(struct _DEVICE_OBJECT **devices, ULONG count);
+extern BOOL razer_is_control(struct _DEVICE_OBJECT *device);
+extern NTSTATUS razer_control_pnp(struct _DEVICE_OBJECT *device, struct _IRP *irp);
+extern NTSTATUS WINAPI razer_dispatch_create(struct _DEVICE_OBJECT *device, struct _IRP *irp);
+extern NTSTATUS WINAPI razer_dispatch_close(struct _DEVICE_OBJECT *device, struct _IRP *irp);
+extern NTSTATUS WINAPI razer_dispatch_ioctl(struct _DEVICE_OBJECT *device, struct _IRP *irp);
+
+#endif /* WINE_UNIX_LIB */
+
+#endif /* __WINEBUS_RAZER_H */
diff --git dlls/winebus.sys/razer_unix.c dlls/winebus.sys/razer_unix.c
new file mode 100644
index 0000000..124a00b
--- /dev/null
+++ dlls/winebus.sys/razer_unix.c
@@ -0,0 +1,1254 @@
+/*
+ * Razer input filter emulation, Unix side
+ *
+ * Copyright 2026 adds39939
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#ifdef HAVE_LIBUDEV_H
+# include <libudev.h>
+#endif
+#ifdef HAVE_LINUX_INPUT_H
+# include <linux/input.h>
+# include <linux/uinput.h>
+#endif
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "ddk/wdm.h"
+#include "ddk/hidtypes.h"
+#include "hidusage.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+
+#include "unix_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(razer);
+
+#if defined(HAVE_UDEV) && defined(HAVE_LINUX_INPUT_H) && defined(UI_DEV_SETUP)
+
+/* See razer.h for what this is for. One filter stands for one USB device, and takes in all
+ * of its evdev nodes; it lives as long as one of the device's hidraw nodes does. Everything
+ * here runs with bus_udev.c's lock held: reading the evdev nodes on the udev thread, and
+ * the control device's requests on whichever thread makes them. */
+
+#define BITS_PER_LONG (sizeof(unsigned long) * 8)
+#define NLONGS(x) (((x) + BITS_PER_LONG - 1) / BITS_PER_LONG)
+
+static inline BOOL test_bit(const unsigned long *bits, unsigned int bit)
+{
+    return (bits[bit / BITS_PER_LONG] >> (bit % BITS_PER_LONG)) & 1;
+}
+
+static inline void set_bit(unsigned long *bits, unsigned int bit, BOOL set)
+{
+    if (set) bits[bit / BITS_PER_LONG] |= 1ul << (bit % BITS_PER_LONG);
+    else bits[bit / BITS_PER_LONG] &= ~(1ul << (bit % BITS_PER_LONG));
+}
+
+/* An evdev node of the device. It is opened for as long as some handle wants any of the
+ * device's input, and grabbed -- held away from the desktop, with a uinput device standing
+ * in for it -- for as long as some handle may want to hold input back. */
+struct razer_node
+{
+    struct list entry;
+    char syspath[256];
+    char name[UINPUT_MAX_NAME_SIZE];
+    struct input_id id;
+    int fd;                                     /* the evdev node, -1 for the spare device */
+    int clone;                                  /* its uinput copy, -1 while not grabbed */
+    BOOL grabbed;
+    unsigned long evbits[NLONGS(EV_CNT)];
+    unsigned long keybits[NLONGS(KEY_CNT)];
+    unsigned long relbits[NLONGS(REL_CNT)];
+    unsigned long mscbits[NLONGS(MSC_CNT)];
+    unsigned long ledbits[NLONGS(LED_CNT)];
+    unsigned long propbits[NLONGS(INPUT_PROP_CNT)];
+    unsigned long down[NLONGS(KEY_CNT)];        /* keys down on the device, as read so far */
+    unsigned long pressed[NLONGS(KEY_CNT)];     /* keys down on the clone */
+    BOOL is_keyboard;                           /* has the letter keys */
+    BOOL dropped;                               /* lost events: resync at the end of the frame */
+    UINT frame_count;
+    struct input_event frame[64];
+    UINT out_count;                             /* events for the clone, written a frame at a time */
+    struct input_event out[64];
+    INT wheel_rest, hwheel_rest;                /* injected high resolution scrolling, not a notch yet */
+};
+
+struct razer_held
+{
+    struct list entry;
+    struct razer_hook *hook;
+};
+
+struct razer_hook_entry
+{
+    struct list entry;
+    struct razer_hook hook;
+    BOOL held;                                  /* took a press whose release is still to come */
+    BOOL removed;                               /* removed while held, goes with the release */
+};
+
+struct razer_filter
+{
+    struct list entry;
+    LONG ref;
+    UINT64 id;
+    char syspath[256];                          /* the USB device's */
+    struct device_desc desc;
+
+    UINT subscriptions;                         /* RAZER_EVENT_* some handle receives */
+    BOOL hooks_enabled;
+    BOOL redirect_keyboard;
+    BOOL redirect_mouse;
+    BOOL redirect_move;
+    UINT modifiers;
+    BOOL pause_pending;                         /* injected E1 1D, waiting for its 45 */
+
+    struct list hooks;
+    struct list held;
+    struct list nodes;
+    struct razer_node *spare;                   /* a uinput device for input no clone has */
+};
+
+static struct udev *udev;
+static struct list filters = LIST_INIT(filters);
+static UINT64 last_filter_id;
+static struct list *event_queue;
