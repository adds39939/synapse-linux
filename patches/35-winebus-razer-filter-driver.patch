+/* A file descriptor polled for razer_unix.c rather than for a device, which takes it
+ * over: it is closed once it is no longer polled. */
+BOOL udev_watch_fd(int fd)
+{
+    if (poll_count >= ARRAY_SIZE(poll_fds))
+    {
+        ERR("could not start polling fd %d, too many fds\n", fd);
+        return FALSE;
+    }
+    poll_devs[poll_count] = NULL;
+    poll_fds[poll_count].fd = fd;
+    poll_fds[poll_count].events = POLLIN;
+    poll_fds[poll_count].revents = 0;
+    poll_count++;
+    write(deviceloop_control[1], "u", 1);
+    return TRUE;
+}
+
+void udev_unwatch_fd(int fd)
+{
+    int i;
+
+    for (i = 2; i < poll_count; ++i)
+        if (poll_fds[i].fd == fd && !poll_devs[i]) break;
+    if (i < poll_count)
+    {
+        poll_count--;
+        poll_fds[i] = poll_fds[poll_count];
+        poll_devs[i] = poll_devs[poll_count];
+    }
+    if (close_count < ARRAY_SIZE(close_fds)) close_fds[close_count++] = fd;
+    else close(fd);
+    write(deviceloop_control[1], "u", 1);
+}
