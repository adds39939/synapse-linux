+/* Set 1 scan codes, with 0x100 for an E0 prefix and 0x200 for E1, by evdev key code.
+ * The ones up to KEY_KPDOT are the same numbers. */
+static const struct { USHORT key; USHORT scan; } key_scans[] =
+{
+    {KEY_ZENKAKUHANKAKU, 0x29}, {KEY_102ND, 0x56}, {KEY_F11, 0x57}, {KEY_F12, 0x58},
+    {KEY_RO, 0x73}, {KEY_KATAKANAHIRAGANA, 0x70}, {KEY_HENKAN, 0x79}, {KEY_MUHENKAN, 0x7b},
+    {KEY_KPJPCOMMA, 0x5c}, {KEY_KPENTER, 0x11c}, {KEY_RIGHTCTRL, 0x11d}, {KEY_KPSLASH, 0x135},
+    {KEY_SYSRQ, 0x137}, {KEY_RIGHTALT, 0x138}, {KEY_HOME, 0x147}, {KEY_UP, 0x148},
+    {KEY_PAGEUP, 0x149}, {KEY_LEFT, 0x14b}, {KEY_RIGHT, 0x14d}, {KEY_END, 0x14f},
+    {KEY_DOWN, 0x150}, {KEY_PAGEDOWN, 0x151}, {KEY_INSERT, 0x152}, {KEY_DELETE, 0x153},
+    {KEY_MUTE, 0x120}, {KEY_VOLUMEDOWN, 0x12e}, {KEY_VOLUMEUP, 0x130}, {KEY_POWER, 0x15e},
+    {KEY_KPEQUAL, 0x59}, {KEY_PAUSE, 0x21d}, {KEY_KPCOMMA, 0x7e}, {KEY_HANGEUL, 0xf2},
+    {KEY_HANJA, 0xf1}, {KEY_YEN, 0x7d}, {KEY_LEFTMETA, 0x15b}, {KEY_RIGHTMETA, 0x15c},
+    {KEY_COMPOSE, 0x15d}, {KEY_STOP, 0x168}, {KEY_HELP, 0x63}, {KEY_CALC, 0x121},
+    {KEY_SLEEP, 0x15f}, {KEY_WAKEUP, 0x163}, {KEY_MAIL, 0x16c}, {KEY_BOOKMARKS, 0x166},
+    {KEY_COMPUTER, 0x16b}, {KEY_BACK, 0x16a}, {KEY_FORWARD, 0x169}, {KEY_NEXTSONG, 0x119},
+    {KEY_PLAYPAUSE, 0x122}, {KEY_PREVIOUSSONG, 0x110}, {KEY_STOPCD, 0x124}, {KEY_HOMEPAGE, 0x132},
+    {KEY_REFRESH, 0x167}, {KEY_F13, 0x64}, {KEY_F14, 0x65}, {KEY_F15, 0x66}, {KEY_F16, 0x67},
+    {KEY_F17, 0x68}, {KEY_F18, 0x69}, {KEY_F19, 0x6a}, {KEY_F20, 0x6b}, {KEY_F21, 0x6c},
+    {KEY_F22, 0x6d}, {KEY_F23, 0x6e}, {KEY_F24, 0x76}, {KEY_SEARCH, 0x165}, {KEY_MEDIA, 0x16d},
+    {KEY_MENU, 0x15d}, {KEY_PRINT, 0x137}, {KEY_FIND, 0x165},
+};
+
+static USHORT key_to_scan(USHORT key)
+{
+    UINT i;
+
+    if (key && key <= KEY_KPDOT) return key;
+    for (i = 0; i < ARRAY_SIZE(key_scans); i++) if (key_scans[i].key == key) return key_scans[i].scan;
+    return 0;
+}
+
+static USHORT scan_to_key(USHORT scan)
+{
+    UINT i;
+
+    if (scan && scan <= KEY_KPDOT) return scan;
+    for (i = 0; i < ARRAY_SIZE(key_scans); i++) if (key_scans[i].scan == scan) return key_scans[i].key;
+    return 0;
+}
+
+/* Mouse buttons, and the MOUSE_INPUT_DATA bits for their press; the release is the next
+ * bit up. Buttons past the fifth have no ButtonFlags: Razer's driver puts them in
+ * ButtonData, from bit 0. */
+static const struct { USHORT button; UINT down; } button_flags[] =
+{
+    {BTN_LEFT, RAZER_MOUSE_LEFT_DOWN}, {BTN_RIGHT, RAZER_MOUSE_RIGHT_DOWN},
+    {BTN_MIDDLE, RAZER_MOUSE_MIDDLE_DOWN}, {BTN_SIDE, RAZER_MOUSE_BUTTON4_DOWN},
+    {BTN_EXTRA, RAZER_MOUSE_BUTTON5_DOWN}, {BTN_FORWARD, 0x00010000}, {BTN_BACK, 0x00040000},
+    {BTN_TASK, 0x00100000},
+};
+
+static struct razer_filter *find_filter(UINT64 id)
+{
+    struct razer_filter *filter;
+
+    LIST_FOR_EACH_ENTRY(filter, &filters, struct razer_filter, entry)
+        if (filter->id == id) return filter;
+    return NULL;
+}
+
+static void clone_flush(struct razer_node *node)
+{
+    ssize_t size = node->out_count * sizeof(*node->out);
+
+    if (node->out_count && write(node->clone, node->out, size) != size)
+        WARN("failed to write to the clone of %s: %s\n", node->syspath, strerror(errno));
+    node->out_count = 0;
+}
+
+/* queue an event for the clone; the end of a frame sends it all at once */
+static void clone_write(struct razer_node *node, USHORT type, USHORT code, INT value)
+{
+    struct input_event *event;
+
+    if (node->clone < 0) return;
+    if (type == EV_KEY && code < KEY_CNT) set_bit(node->pressed, code, value != 0);
+    if (node->out_count == ARRAY_SIZE(node->out)) clone_flush(node);
+    event = &node->out[node->out_count++];
+    memset(event, 0, sizeof(*event));
+    event->type = type;
+    event->code = code;
+    event->value = value;
+    if (type == EV_SYN && code == SYN_REPORT) clone_flush(node);
+}
+
+static int create_uinput(const char *name, const struct input_id *id, const unsigned long *evbits,
+                         const unsigned long *keybits, const unsigned long *relbits,
+                         const unsigned long *mscbits, const unsigned long *ledbits,
+                         const unsigned long *propbits, int source)
+{
+    struct uinput_setup setup = {0};
+    unsigned int i;
+    int fd;
+
+    if ((fd = open("/dev/uinput", O_RDWR | O_NONBLOCK | O_CLOEXEC)) < 0)
+    {
+        ERR("cannot open /dev/uinput: %s; a udev rule must give it to the seat, see 60-razer-synapse.rules\n",
+            strerror(errno));
+        return -1;
+    }
+
+    for (i = 0; i < EV_CNT; i++)
+    {
+        /* force feedback and the like would have to be handed on to the device; LEDs are */
+        if (i == EV_FF || i == EV_SND || i == EV_SW || i == EV_PWR || i == EV_FF_STATUS) continue;
+        if (test_bit(evbits, i)) ioctl(fd, UI_SET_EVBIT, i);
+    }
+    for (i = 0; i < KEY_CNT; i++) if (test_bit(keybits, i)) ioctl(fd, UI_SET_KEYBIT, i);
+    for (i = 0; i < REL_CNT; i++) if (test_bit(relbits, i)) ioctl(fd, UI_SET_RELBIT, i);
+    if (mscbits) for (i = 0; i < MSC_CNT; i++) if (test_bit(mscbits, i)) ioctl(fd, UI_SET_MSCBIT, i);
+    if (ledbits) for (i = 0; i < LED_CNT; i++) if (test_bit(ledbits, i)) ioctl(fd, UI_SET_LEDBIT, i);
+    if (propbits) for (i = 0; i < INPUT_PROP_CNT; i++) if (test_bit(propbits, i)) ioctl(fd, UI_SET_PROPBIT, i);
+    if (source >= 0 && test_bit(evbits, EV_ABS))
+    {
+        unsigned long absbits[NLONGS(ABS_CNT)] = {0};
+
+        ioctl(source, EVIOCGBIT(EV_ABS, sizeof(absbits)), absbits);
+        for (i = 0; i < ABS_CNT; i++)
+        {
+            struct uinput_abs_setup abs = {.code = i};
+            if (!test_bit(absbits, i) || ioctl(source, EVIOCGABS(i), &abs.absinfo) < 0) continue;
+            ioctl(fd, UI_SET_ABSBIT, i);
+            ioctl(fd, UI_ABS_SETUP, &abs);
+        }
+    }
+
+    /* the same name and ids as the device, so that the desktop gives the clone the
+     * device's settings -- pointer acceleration, scrolling, keyboard layout */
+    setup.id = *id;
+    snprintf(setup.name, sizeof(setup.name), "%s", name);
+    if (ioctl(fd, UI_DEV_SETUP, &setup) < 0 || ioctl(fd, UI_DEV_CREATE) < 0)
+    {
+        ERR("cannot create uinput device %s: %s\n", debugstr_a(name), strerror(errno));
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+static void release_clone(struct razer_node *node)
+{
+    BOOL pressed = FALSE;
+    unsigned int i;
+
+    for (i = 0; i < KEY_CNT; i++)
+    {
+        if (!test_bit(node->pressed, i)) continue;
+        clone_write(node, EV_KEY, i, 0);
+        pressed = TRUE;
+    }
+    if (pressed) clone_write(node, EV_SYN, SYN_REPORT, 0);
+}
+
+/* Let a node go back to the desktop. */
+static void node_ungrab(struct razer_node *node)
+{
+    if (!node->grabbed) return;
+    release_clone(node);
+    ioctl(node->clone, UI_DEV_DESTROY);
+    udev_unwatch_fd(node->clone);
+    node->clone = -1;
+    ioctl(node->fd, EVIOCGRAB, 0);
+    node->grabbed = FALSE;
+    TRACE("let go of %s\n", node->syspath);
+}
+
+/* Take a node from the desktop. Not while one of its keys is held down: the desktop
+ * would never see it come up. Then this is tried again at the end of each frame. */
+static void node_grab(struct razer_node *node)
+{
+    unsigned long down[NLONGS(KEY_CNT)] = {0};
+    unsigned int i;
+
+    if (node->grabbed || node->fd < 0) return;
+
+    ioctl(node->fd, EVIOCGKEY(sizeof(down)), down);
+    for (i = 0; i < ARRAY_SIZE(down); i++) if (down[i] & node->keybits[i]) return;
+
+    if ((node->clone = create_uinput(node->name, &node->id, node->evbits, node->keybits, node->relbits,
+                                     node->mscbits, node->ledbits, node->propbits, node->fd)) < 0)
+        return;
+    if (ioctl(node->fd, EVIOCGRAB, 1) < 0 || !udev_watch_fd(node->clone))
+    {
+        ERR("cannot grab %s: %s\n", node->syspath, strerror(errno));
+        ioctl(node->fd, EVIOCGRAB, 0);
+        ioctl(node->clone, UI_DEV_DESTROY);
+        close(node->clone);
+        node->clone = -1;
+        return;
+    }
+
+    memset(node->down, 0, sizeof(node->down));
+    memset(node->pressed, 0, sizeof(node->pressed));
+    node->grabbed = TRUE;
+    TRACE("grabbed %s %s, keyboard %u\n", node->syspath, debugstr_a(node->name), node->is_keyboard);
+}
+
+static void node_close(struct razer_node *node)
+{
+    if (node->fd < 0)
+    {
+        /* the spare device, never polled */
+        release_clone(node);
+        ioctl(node->clone, UI_DEV_DESTROY);
+        close(node->clone);
+    }
+    else
+    {
+        node_ungrab(node);
+        udev_unwatch_fd(node->fd);
+    }
+    free(node);
+}
+
+static struct razer_node *node_open(const char *syspath, const char *devnode)
+{
+    struct razer_node *node;
+
+    if (!(node = calloc(1, sizeof(*node)))) return NULL;
+    snprintf(node->syspath, sizeof(node->syspath), "%s", syspath);
+    node->clone = -1;
+
+    /* write access is for handing the desktop's keyboard LEDs on, see razer_filter_read */
+    if ((node->fd = open(devnode, O_RDWR | O_NONBLOCK | O_CLOEXEC)) < 0 &&
+        (node->fd = open(devnode, O_RDONLY | O_NONBLOCK | O_CLOEXEC)) < 0)
+    {
+        ERR("cannot open %s: %s; a udev rule must give it to the seat, see 60-razer-synapse.rules\n",
+            debugstr_a(devnode), strerror(errno));
+        free(node);
+        return NULL;
+    }
+
+    ioctl(node->fd, EVIOCGID, &node->id);
+    ioctl(node->fd, EVIOCGNAME(sizeof(node->name) - 1), node->name);
+    ioctl(node->fd, EVIOCGBIT(0, sizeof(node->evbits)), node->evbits);
+    ioctl(node->fd, EVIOCGBIT(EV_KEY, sizeof(node->keybits)), node->keybits);
+    ioctl(node->fd, EVIOCGBIT(EV_REL, sizeof(node->relbits)), node->relbits);
+    ioctl(node->fd, EVIOCGBIT(EV_MSC, sizeof(node->mscbits)), node->mscbits);
+    ioctl(node->fd, EVIOCGBIT(EV_LED, sizeof(node->ledbits)), node->ledbits);
+    ioctl(node->fd, EVIOCGPROP(sizeof(node->propbits)), node->propbits);
+    ioctl(node->fd, EVIOCGKEY(sizeof(node->down)), node->down);
+    node->is_keyboard = test_bit(node->keybits, KEY_A) && test_bit(node->keybits, KEY_Z);
+
+    if (!udev_watch_fd(node->fd))
+    {
+        close(node->fd);
+        free(node);
+        return NULL;
+    }
+    TRACE("opened %s %s\n", debugstr_a(devnode), debugstr_a(node->name));
+    return node;
+}
+
+/* Open the device's evdev nodes not open yet. */
+static void filter_open_nodes(struct razer_filter *filter)
+{
+    struct udev_list_entry *item;
+    struct udev_enumerate *enumerate;
+    struct udev_device *usb;
+    struct razer_node *node;
+
+    if (!udev || !(usb = udev_device_new_from_syspath(udev, filter->syspath))) return;
+    if (!(enumerate = udev_enumerate_new(udev)))
+    {
+        udev_device_unref(usb);
+        return;
+    }
+
+    udev_enumerate_add_match_parent(enumerate, usb);
+    udev_enumerate_add_match_subsystem(enumerate, "input");
+    udev_enumerate_add_match_sysname(enumerate, "event*");
+    udev_enumerate_scan_devices(enumerate);
+
+    udev_list_entry_foreach(item, udev_enumerate_get_list_entry(enumerate))
+    {
+        const char *syspath = udev_list_entry_get_name(item), *devnode;
+        struct udev_device *dev;
+        BOOL known = FALSE;
+
+        LIST_FOR_EACH_ENTRY(node, &filter->nodes, struct razer_node, entry)
+            if (!strcmp(node->syspath, syspath)) known = TRUE;
+        if (known || !(dev = udev_device_new_from_syspath(udev, syspath))) continue;
+        if ((devnode = udev_device_get_devnode(dev)) && (node = node_open(syspath, devnode)))
+            list_add_tail(&filter->nodes, &node->entry);
+        udev_device_unref(dev);
+    }
+
+    udev_enumerate_unref(enumerate);
+    udev_device_unref(usb);
+}
+
+/* Forget the presses hooks are holding, once nothing will bring their releases. */
+static void filter_drop_held(struct razer_filter *filter)
+{
+    struct razer_held *held, *next;
+    struct razer_hook_entry *entry;
+
+    LIST_FOR_EACH_ENTRY_SAFE(held, next, &filter->held, struct razer_held, entry)
+    {
+        entry = CONTAINING_RECORD(held->hook, struct razer_hook_entry, hook);
+        entry->held = FALSE;
+        if (entry->removed)
+        {
+            list_remove(&entry->entry);
+            free(entry);
+        }
+        list_remove(&held->entry);
+        free(held);
+    }
+}
+
+static BOOL filter_wants_grab(struct razer_filter *filter)
+{
+    return !!(filter->subscriptions & (RAZER_EVENT_HOOK | RAZER_EVENT_REDIRECT));
+}
+
+static void filter_update(struct razer_filter *filter)
+{
+    struct razer_node *node, *next;
+
+    if (filter->subscriptions) filter_open_nodes(filter);
+    LIST_FOR_EACH_ENTRY_SAFE(node, next, &filter->nodes, struct razer_node, entry)
+    {
+        if (!filter->subscriptions)
+        {
+            list_remove(&node->entry);
+            node_close(node);
+        }
+        else if (filter_wants_grab(filter)) node_grab(node);
+        else node_ungrab(node);
+    }
+    if (!filter_wants_grab(filter))
+    {
+        if (filter->spare) node_close(filter->spare);
+        filter->spare = NULL;
+        filter_drop_held(filter);
+        filter->modifiers = 0;
+    }
+}
+
+static void filter_clear_hooks(struct razer_filter *filter)
+{
+    struct razer_hook_entry *entry, *next;
+
+    filter->subscriptions = 0;
+    filter_update(filter);
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &filter->hooks, struct razer_hook_entry, entry)
+    {
+        list_remove(&entry->entry);
+        free(entry);
+    }
+    filter->hooks_enabled = TRUE;
+    filter->redirect_keyboard = filter->redirect_mouse = filter->redirect_move = FALSE;
+}
+
+struct razer_filter *razer_filter_add(struct udev *context, struct udev_device *dev,
+                                      const struct device_desc *desc, struct list *queue)
+{
+    struct udev_device *usb = udev_device_get_parent_with_subsystem_devtype(dev, "usb", "usb_device");
+    const char *syspath = usb ? udev_device_get_syspath(usb) : NULL;
+    struct razer_filter *filter;
+
+    if (!syspath || strlen(syspath) >= sizeof(filter->syspath)) return NULL;
+    udev = context;
+    event_queue = queue;
+
+    LIST_FOR_EACH_ENTRY(filter, &filters, struct razer_filter, entry)
+    {
+        if (strcmp(filter->syspath, syspath)) continue;
+        filter->ref++;
+        /* an interface that came late may have brought evdev nodes with it */
+        if (filter->subscriptions) filter_update(filter);
+        return filter;
+    }
+
+    if (!(filter = calloc(1, sizeof(*filter)))) return NULL;
+    filter->ref = 1;
+    filter->id = ++last_filter_id;
+    strcpy(filter->syspath, syspath);
+    filter->desc = *desc;
+    filter->desc.input = -1;
+    filter->hooks_enabled = TRUE;
+    list_init(&filter->hooks);
+    list_init(&filter->held);
+    list_init(&filter->nodes);
+    list_add_tail(&filters, &filter->entry);
+
+    TRACE("filter %s for %04x:%04x at %s\n", wine_dbgstr_longlong(filter->id), desc->vid, desc->pid, syspath);
+    bus_event_queue_razer_created(queue, filter->id, &filter->desc);
+    return filter;
+}
+
+void razer_filter_release(struct razer_filter *filter, struct list *queue)
+{
+    if (--filter->ref) return;
+
+    TRACE("filter %s gone\n", wine_dbgstr_longlong(filter->id));
+    filter_clear_hooks(filter);
+    list_remove(&filter->entry);
+    bus_event_queue_razer_removed(queue, filter->id);
+    free(filter);
+}
+
+/* bus_udev.c's loop is ending, and its udev context with it */
+void razer_filter_shutdown(void)
+{
+    struct razer_filter *filter;
+
+    LIST_FOR_EACH_ENTRY(filter, &filters, struct razer_filter, entry)
+    {
+        filter->subscriptions = 0;
+        filter_update(filter);
+    }
+    udev = NULL;
+}
+
+/* What RzCommon.sys does to find the hook for an input. A release, or a repeated press,
+ * goes to the hook that took the press, whatever modifier keys are held by then. A press
+ * goes to a hook for exactly the modifier keys held, failing that to one for a subset of
+ * them, failing that to one for none. Input injected by the filter itself only goes to
+ * hooks that ask for injected input. */
+static BOOL hook_same_input(const struct razer_input *hook, const struct razer_input *input)
+{
+    UINT hook_buttons, input_buttons;
+    BOOL match;
+
+    if (hook->type != input->type) return FALSE;
+    if ((hook->keyboard.unit_id == RAZER_UNIT_INJECTED) != (input->keyboard.unit_id == RAZER_UNIT_INJECTED)) return FALSE;
+
+    switch (input->type)
+    {
+    case RAZER_INPUT_KEYBOARD:
+    case RAZER_INPUT_DKM:
+        return hook->keyboard.make_code == input->keyboard.make_code &&
+               !((hook->keyboard.flags ^ input->keyboard.flags) & ~RAZER_KEY_BREAK);
+    case RAZER_INPUT_CONSUMER:
+        return (BYTE)hook->keyboard.make_code == (BYTE)input->keyboard.make_code;
+    case RAZER_INPUT_MOUSE:
+        hook_buttons = hook->mouse.button_flags | (UINT)hook->mouse.button_data << 16;
+        input_buttons = input->mouse.button_flags | (UINT)input->mouse.button_data << 16;
+        match = (hook->mouse.button_flags & input->mouse.button_flags) != 0;
+        if (input->mouse.button_flags & RAZER_MOUSE_WHEEL) match = match && hook_buttons == input_buttons;
+        if ((input->mouse.button_flags & RAZER_MOUSE_HWHEEL) && hook_buttons != input_buttons) match = FALSE;
+        if (!input->mouse.button_flags && (hook_buttons & input_buttons)) match = TRUE;
+        return match;
+    }
+    return FALSE;
+}
+
+static UINT input_modifiers(const struct razer_input *input)
+{
+    return input->type == RAZER_INPUT_MOUSE ? input->mouse.modifiers : input->keyboard.modifiers;
+}
+
+static BOOL input_is_wheel(const struct razer_input *input)
+{
+    return input->type == RAZER_INPUT_MOUSE && (input->mouse.button_flags & (RAZER_MOUSE_WHEEL | RAZER_MOUSE_HWHEEL));
+}
+
+/* the hook holding the press of an input, if any; a release lets go of it */
+static struct razer_hook_entry *find_held(struct razer_filter *filter, const struct razer_input *input, BOOL press)
+{
+    struct razer_hook_entry *entry;
+    struct razer_held *held;
+
+    LIST_FOR_EACH_ENTRY_REV(held, &filter->held, struct razer_held, entry)
+    {
+        entry = CONTAINING_RECORD(held->hook, struct razer_hook_entry, hook);
+        if (!hook_same_input(&entry->hook.input, input)) continue;
+        if (!press)
+        {
+            list_remove(&held->entry);
+            free(held);
+            entry->held = FALSE;
+        }
+        return entry;
+    }
+    return NULL;
+}
+
+static struct razer_hook_entry *find_hook(struct razer_filter *filter, const struct razer_input *input)
+{
+    struct razer_hook_entry *entry, *exact = NULL, *subset = NULL, *any = NULL;
+    struct razer_held *held;
+    UINT mods = input_modifiers(input), hook_mods;
+
+    LIST_FOR_EACH_ENTRY_REV(entry, &filter->hooks, struct razer_hook_entry, entry)
+    {
+        if (entry->held || entry->removed || !hook_same_input(&entry->hook.input, input)) continue;
+        hook_mods = input_modifiers(&entry->hook.input);
+        if (hook_mods == mods)
+        {
+            exact = entry;
+            break;
+        }
+        if (!hook_mods) any = entry;
+        else if ((mods & hook_mods) == hook_mods &&
+                 (!((mods ^ hook_mods) & 0x3000000) || input->type == RAZER_INPUT_DKM)) subset = entry;
+    }
+    if (!(entry = exact ? exact : subset ? subset : any)) return NULL;
+
+    if (!input_is_wheel(input) && (held = malloc(sizeof(*held))))
+    {
+        held->hook = &entry->hook;
+        list_add_tail(&filter->held, &held->entry);
+        entry->held = TRUE;
+    }
+    return entry;
+}
+
+static BOOL hook_equal(const struct razer_input *hook, const struct razer_input *input)
+{
+    if (hook->type != input->type) return FALSE;
+    if ((hook->keyboard.unit_id == RAZER_UNIT_INJECTED) != (input->keyboard.unit_id == RAZER_UNIT_INJECTED)) return FALSE;
+
+    switch (input->type)
+    {
+    case RAZER_INPUT_KEYBOARD:
+    case RAZER_INPUT_DKM:
+        return hook->keyboard.make_code == input->keyboard.make_code &&
+               !((hook->keyboard.flags ^ input->keyboard.flags) & ~RAZER_KEY_BREAK) &&
+               hook->keyboard.modifiers == input->keyboard.modifiers;
+    case RAZER_INPUT_CONSUMER:
+        return (BYTE)hook->keyboard.make_code == (BYTE)input->keyboard.make_code &&
+               hook->keyboard.modifiers == input->keyboard.modifiers;
+    case RAZER_INPUT_MOUSE:
+        return hook->mouse.button_flags == input->mouse.button_flags &&
+               hook->mouse.button_data == input->mouse.button_data &&
+               hook->mouse.modifiers == input->mouse.modifiers;
+    }
+    return FALSE;
+}
+
+static void remove_hook(struct razer_filter *filter, const struct razer_input *input)
+{
+    struct razer_hook_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(entry, next, &filter->hooks, struct razer_hook_entry, entry)
+    {
+        if (entry->removed || !hook_equal(&entry->hook.input, input)) continue;
+        if (entry->held) entry->removed = TRUE;
+        else
+        {
+            list_remove(&entry->entry);
+            free(entry);
+        }
+    }
+}
+
+static void queue_event(struct razer_filter *filter, UINT kind, const struct razer_input *input,
+                        const struct razer_hook *hook)
+{
+    struct razer_event event = {.kind = kind};
+
+    if (hook) event.hook = *hook;
+    event.hook.input = *input;
+    TRACE("filter %s kind %#x type %#x %s\n", wine_dbgstr_longlong(filter->id), kind, input->type,
+          input->type == RAZER_INPUT_MOUSE
+          ? wine_dbg_sprintf("buttons %#x data %#x move %d,%d", input->mouse.button_flags,
+                             input->mouse.button_data, input->mouse.last_x, input->mouse.last_y)
+          : wine_dbg_sprintf("make %#x flags %#x", input->keyboard.make_code, input->keyboard.flags));
+    bus_event_queue_razer_event(event_queue, filter->id, &event);
+}
+
+/* The modifier keys held, as RzCommon.sys tracks them from what it lets through and what
+ * is injected. */
+static void track_modifiers(struct razer_filter *filter, const struct razer_input *input)
+{
+    BOOL press = !(input->keyboard.flags & RAZER_KEY_BREAK), e0 = !!(input->keyboard.flags & RAZER_KEY_E0);
+    UINT bit = 0;
+
+    if (input->type != RAZER_INPUT_KEYBOARD || (input->keyboard.flags & RAZER_KEY_E1)) return;
+    switch (input->keyboard.make_code)
+    {
+    case 0x1d: bit = e0 ? RAZER_MOD_RCTRL : RAZER_MOD_LCTRL; break;
+    case 0x2a: bit = RAZER_MOD_LSHIFT; break;
+    case 0x36: bit = RAZER_MOD_RSHIFT; break;
+    case 0x38: bit = e0 ? RAZER_MOD_RALT : RAZER_MOD_LALT; break;
+    }
+    if (press) filter->modifiers |= bit;
+    else filter->modifiers &= ~bit;
+}
+
+/* An input from the device: TRUE if the filter takes it, FALSE if it goes on. From a node
+ * not grabbed, nothing can be taken, only reported. */
+static BOOL filter_input(struct razer_filter *filter, struct razer_node *node, struct razer_input *input, BOOL press)
+{
+    struct razer_hook_entry *entry;
+    BOOL keyboard = input->type == RAZER_INPUT_KEYBOARD;
+
+    if (keyboard) input->keyboard.modifiers = filter->modifiers;
+    else input->mouse.modifiers = filter->modifiers;
+
+    if (node->grabbed && (filter->subscriptions & RAZER_EVENT_REDIRECT) &&
+        (keyboard ? filter->redirect_keyboard : filter->redirect_mouse))
+    {
+        queue_event(filter, RAZER_EVENT_REDIRECT, input, NULL);
+        return TRUE;
+    }
+
+    if ((filter->subscriptions & RAZER_EVENT_NOTIFY) && (keyboard || input->mouse.button_flags || input->mouse.button_data))
+        queue_event(filter, RAZER_EVENT_NOTIFY, input, NULL);
+
+    /* the release of a press a hook took goes the same way, whatever has changed since */
+    if (!press && !input_is_wheel(input) && (entry = find_held(filter, input, FALSE)))
+    {
+        if (filter->subscriptions & RAZER_EVENT_HOOK) queue_event(filter, RAZER_EVENT_HOOK, input, &entry->hook);
+        if (entry->removed && !entry->held)
+        {
+            list_remove(&entry->entry);
+            free(entry);
+        }
+        return TRUE;
+    }
+
+    if (node->grabbed && (press || input_is_wheel(input)) && (filter->subscriptions & RAZER_EVENT_HOOK) &&
+        filter->hooks_enabled && ((entry = find_held(filter, input, TRUE)) || (entry = find_hook(filter, input))))
+    {
+        queue_event(filter, RAZER_EVENT_HOOK, input, &entry->hook);
+        return TRUE;
+    }
+
+    track_modifiers(filter, input);
+    return FALSE;
+}
+
+/* One frame from an evdev node, up to SYN_REPORT. Keys and buttons are filtered one by
+ * one, and each wheel as it moved in the frame -- one report from the device, as Windows
+ * gets it too. Pointer movement always goes on. */
+static void process_frame(struct razer_filter *filter, struct razer_node *node)
+{
+    INT wheel = 0, wheel_hr = 0, hwheel = 0, hwheel_hr = 0;
+    BOOL has_wheel = FALSE, has_wheel_hr = FALSE, has_hwheel = FALSE, has_hwheel_hr = FALSE;
+    struct razer_input input;
+    BOOL written = FALSE;
+    UINT i, j;
+
+    for (i = 0; i < node->frame_count; i++)
+    {
+        struct input_event *event = &node->frame[i];
+        USHORT scan;
+
+        switch (event->type)
+        {
+        case EV_MSC:
+            break;
+        case EV_KEY:
+            /* the desktop repeats keys itself */
+            if (event->value == 2) break;
+            if (event->code < KEY_CNT) set_bit(node->down, event->code, event->value != 0);
+            memset(&input, 0, sizeof(input));
+            for (j = 0; j < ARRAY_SIZE(button_flags); j++) if (button_flags[j].button == event->code) break;
+            if (j < ARRAY_SIZE(button_flags))
+            {
+                UINT flags = event->value ? button_flags[j].down : button_flags[j].down << 1;
+                input.type = RAZER_INPUT_MOUSE;
+                input.mouse.button_flags = flags;
+                input.mouse.button_data = flags >> 16;
+            }
+            else if ((scan = key_to_scan(event->code)))
+            {
+                input.type = RAZER_INPUT_KEYBOARD;
+                input.keyboard.make_code = scan & 0xff;
+                if (scan & 0x100) input.keyboard.flags |= RAZER_KEY_E0;
+                if (scan & 0x200) input.keyboard.flags |= RAZER_KEY_E1;
+                if (!event->value) input.keyboard.flags |= RAZER_KEY_BREAK;
+            }
+            /* what the clone was told is down comes up there, whoever wants it now */
+            if (!event->value && event->code < KEY_CNT && test_bit(node->pressed, event->code))
+                track_modifiers(filter, &input);
+            else if (input.type && filter_input(filter, node, &input, event->value)) break;
+            clone_write(node, event->type, event->code, event->value);
+            written = TRUE;
+            break;
+        case EV_REL:
+            switch (event->code)
+            {
+            case REL_WHEEL: wheel += event->value; has_wheel = TRUE; break;
+            case REL_WHEEL_HI_RES: wheel_hr += event->value; has_wheel_hr = TRUE; break;
+            case REL_HWHEEL: hwheel += event->value; has_hwheel = TRUE; break;
+            case REL_HWHEEL_HI_RES: hwheel_hr += event->value; has_hwheel_hr = TRUE; break;
+            default:
+                clone_write(node, event->type, event->code, event->value);
+                written = TRUE;
+                break;
+            }
+            break;
+        default:
+            clone_write(node, event->type, event->code, event->value);
+            written = TRUE;
+            break;
+        }
+    }
+
+    if (has_wheel || has_wheel_hr)
+    {
+        memset(&input, 0, sizeof(input));
+        input.type = RAZER_INPUT_MOUSE;
+        input.mouse.button_flags = RAZER_MOUSE_WHEEL;
+        input.mouse.button_data = has_wheel_hr ? wheel_hr : wheel * 120;
+        if (!filter_input(filter, node, &input, TRUE))
+        {
+            if (has_wheel) clone_write(node, EV_REL, REL_WHEEL, wheel);
+            if (has_wheel_hr) clone_write(node, EV_REL, REL_WHEEL_HI_RES, wheel_hr);
+            written = TRUE;
+        }
+    }
+    if (has_hwheel || has_hwheel_hr)
+    {
+        memset(&input, 0, sizeof(input));
+        input.type = RAZER_INPUT_MOUSE;
+        input.mouse.button_flags = RAZER_MOUSE_HWHEEL;
+        input.mouse.button_data = has_hwheel_hr ? hwheel_hr : hwheel * 120;
+        if (!filter_input(filter, node, &input, TRUE))
+        {
+            if (has_hwheel) clone_write(node, EV_REL, REL_HWHEEL, hwheel);
+            if (has_hwheel_hr) clone_write(node, EV_REL, REL_HWHEEL_HI_RES, hwheel_hr);
+            written = TRUE;
+        }
+    }
+
+    if (written) clone_write(node, EV_SYN, SYN_REPORT, 0);
+}
+
+/* Events were lost, or a frame did not fit: bring the keys known to be down back in line
+ * with the device, so that nothing stays held on the clone or in a hook. */
+static void resync_node(struct razer_filter *filter, struct razer_node *node)
+{
+    unsigned long now[NLONGS(KEY_CNT)] = {0};
+    unsigned int i;
+
+    TRACE("%s lost events, resyncing\n", node->syspath);
+    ioctl(node->fd, EVIOCGKEY(sizeof(now)), now);
+    node->frame_count = 0;
+    for (i = 0; i < KEY_CNT && node->frame_count < ARRAY_SIZE(node->frame); i++)
+    {
+        struct input_event *event;
+
+        if (test_bit(node->down, i) == test_bit(now, i)) continue;
+        event = &node->frame[node->frame_count++];
+        memset(event, 0, sizeof(*event));
+        event->type = EV_KEY;
+        event->code = i;
+        event->value = test_bit(now, i);
+    }
+    process_frame(filter, node);
+}
+
+/* LEDs the desktop sets on a clone: the device itself only takes them from whoever holds
+ * the grab */
+static void read_clone(struct razer_node *node)
+{
+    struct input_event events[16];
+    int size, i, count = 0;
+
+    /* leave room for a SYN_REPORT after them */
+    while ((size = read(node->clone, events, sizeof(events) - sizeof(*events))) > 0)
+    {
+        for (i = 0; i < size / (int)sizeof(*events); i++)
+            if (events[i].type == EV_LED) events[count++] = events[i];
+        if (!count) continue;
+        events[count].type = EV_SYN;
+        events[count].code = SYN_REPORT;
+        events[count].value = 0;
+        if (write(node->fd, events, (count + 1) * sizeof(*events)) < 0)
+            WARN("failed to set LEDs on %s: %s\n", node->syspath, strerror(errno));
+        count = 0;
+    }
+}
+
+BOOL razer_filter_read(int fd, struct list *queue)
+{
+    struct razer_filter *filter;
+    struct razer_node *node;
+    struct input_event events[64];
+    int size, i;
+
+    LIST_FOR_EACH_ENTRY(filter, &filters, struct razer_filter, entry)
+    {
+        LIST_FOR_EACH_ENTRY(node, &filter->nodes, struct razer_node, entry)
+        {
+            if (node->clone == fd)
+            {
+                read_clone(node);
+                return TRUE;
+            }
+            if (node->fd != fd) continue;
+            event_queue = queue;
+
+            while ((size = read(fd, events, sizeof(events))) > 0)
+            {
+                for (i = 0; i < size / (int)sizeof(*events); i++)
+                {
+                    if (events[i].type == EV_SYN && events[i].code == SYN_DROPPED)
+                    {
+                        node->dropped = TRUE;
+                        node->frame_count = 0;
+                    }
+                    else if (events[i].type == EV_SYN && events[i].code == SYN_REPORT)
+                    {
+                        if (node->dropped) resync_node(filter, node);
+                        else process_frame(filter, node);
+                        node->dropped = FALSE;
+                        node->frame_count = 0;
+                        if (!node->grabbed && filter_wants_grab(filter)) node_grab(node);
+                    }
+                    else if (node->dropped) continue;
+                    else if (node->frame_count < ARRAY_SIZE(node->frame))
+                        node->frame[node->frame_count++] = events[i];
+                    else
+                    {
+                        node->dropped = TRUE;
+                        node->frame_count = 0;
+                    }
+                }
+            }
+            if (size < 0 && errno == ENODEV)
+            {
+                TRACE("%s is gone\n", node->syspath);
+                list_remove(&node->entry);
+                node_close(node);
+            }
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+/* Where to put injected input: a clone that has the key, preferring a keyboard's for keys,
+ * or a uinput device of the filter's own that has everything. */
+static struct razer_node *output_node(struct razer_filter *filter, USHORT code, BOOL rel)
+{
+    static const struct input_id spare_id = {.bustype = BUS_VIRTUAL, .vendor = 0x1532, .product = 0xffff};
+    unsigned long evbits[NLONGS(EV_CNT)] = {0};
+    struct razer_node *node, *found = NULL;
+    unsigned int i;
+
+    LIST_FOR_EACH_ENTRY(node, &filter->nodes, struct razer_node, entry)
+    {
+        if (!node->grabbed || !test_bit(rel ? node->relbits : node->keybits, code)) continue;
+        if (rel || code >= BTN_MISC || node->is_keyboard) return node;
+        if (!found) found = node;
+    }
+    if (found) return found;
+
+    if (filter->spare) return filter->spare;
+    if (!(node = calloc(1, sizeof(*node)))) return NULL;
+    node->fd = -1;
+    set_bit(evbits, EV_KEY, TRUE);
+    set_bit(evbits, EV_REL, TRUE);
+    for (i = KEY_ESC; i < BTN_MISC; i++) set_bit(node->keybits, i, TRUE);
+    for (i = KEY_OK; i < KEY_MAX; i++) set_bit(node->keybits, i, TRUE);
+    for (i = BTN_LEFT; i <= BTN_TASK; i++) set_bit(node->keybits, i, TRUE);
+    set_bit(node->relbits, REL_X, TRUE);
+    set_bit(node->relbits, REL_Y, TRUE);
+    set_bit(node->relbits, REL_WHEEL, TRUE);
+    set_bit(node->relbits, REL_HWHEEL, TRUE);
+    set_bit(node->relbits, REL_WHEEL_HI_RES, TRUE);
+    set_bit(node->relbits, REL_HWHEEL_HI_RES, TRUE);
+    strcpy(node->syspath, "spare");
+    if ((node->clone = create_uinput("Razer Synapse virtual input", &spare_id, evbits, node->keybits,
+                                     node->relbits, NULL, NULL, NULL, -1)) < 0)
+    {
+        free(node);
+        return NULL;
+    }
+    return filter->spare = node;
+}
+
+static void send_key(struct razer_filter *filter, USHORT code, BOOL press)
+{
+    struct razer_node *node;
+
+    if (!code || !(node = output_node(filter, code, FALSE))) return;
+    clone_write(node, EV_KEY, code, press);
+    clone_write(node, EV_SYN, SYN_REPORT, 0);
+}
+
+static void send_scroll(struct razer_node *node, USHORT code, USHORT code_hr, SHORT data, INT *rest)
+{
+    *rest += data;
+    if (test_bit(node->relbits, code_hr)) clone_write(node, EV_REL, code_hr, data);
+    if (*rest / 120)
+    {
+        clone_write(node, EV_REL, code, *rest / 120);
+        *rest %= 120;
+    }
+}
+
+static void send_input(struct razer_filter *filter, const struct razer_send_input *send)
+{
+    struct razer_input input = {0};
+    struct razer_node *node;
+    USHORT scan, data;
+    UINT i, flags;
+
+    switch (send->type)
+    {
+    case RAZER_INPUT_KEYBOARD:
+        input.type = RAZER_INPUT_KEYBOARD;
+        input.keyboard.make_code = send->keyboard.make_code;
+        input.keyboard.flags = send->keyboard.flags;
+        track_modifiers(filter, &input);
+
+        /* Pause comes as E1 1D, then 45 */
+        if (send->keyboard.flags & RAZER_KEY_E1)
+        {
+            filter->pause_pending = send->keyboard.make_code == 0x1d;
+            send_key(filter, KEY_PAUSE, !(send->keyboard.flags & RAZER_KEY_BREAK));
+            break;
+        }
+        if (filter->pause_pending && send->keyboard.make_code == 0x45)
+        {
+            filter->pause_pending = FALSE;
+            break;
+        }
+        scan = send->keyboard.make_code | (send->keyboard.flags & RAZER_KEY_E0 ? 0x100 : 0);
+        TRACE("filter %s key %#x %s\n", wine_dbgstr_longlong(filter->id), scan,
+              send->keyboard.flags & RAZER_KEY_BREAK ? "up" : "down");
+        if (!scan_to_key(scan)) FIXME("no key for scan code %#x\n", scan);
+        send_key(filter, scan_to_key(scan), !(send->keyboard.flags & RAZER_KEY_BREAK));
+        break;
+
+    case RAZER_INPUT_MOUSE:
+        TRACE("filter %s mouse flags %#x buttons %#x data %#x move %d,%d\n", wine_dbgstr_longlong(filter->id),
+              send->mouse.flags, send->mouse.button_flags, send->mouse.button_data,
+              send->mouse.last_x, send->mouse.last_y);
+        if (!(node = output_node(filter, REL_X, TRUE))) break;
+
+        flags = send->mouse.button_flags;
+        if (!(flags & (RAZER_MOUSE_WHEEL | RAZER_MOUSE_HWHEEL))) flags |= (UINT)send->mouse.button_data << 16;
+        for (i = 0; i < ARRAY_SIZE(button_flags); i++)
+        {
+            if (flags & button_flags[i].down) clone_write(node, EV_KEY, button_flags[i].button, 1);
+            if (flags & (button_flags[i].down << 1)) clone_write(node, EV_KEY, button_flags[i].button, 0);
+        }
+        data = send->mouse.button_data;
+        if (flags & RAZER_MOUSE_WHEEL) send_scroll(node, REL_WHEEL, REL_WHEEL_HI_RES, data, &node->wheel_rest);
+        if (flags & RAZER_MOUSE_HWHEEL) send_scroll(node, REL_HWHEEL, REL_HWHEEL_HI_RES, data, &node->hwheel_rest);
+
+        if (send->mouse.flags & RAZER_MOUSE_MOVE_ABSOLUTE)
+        {
+            if (send->mouse.last_x || send->mouse.last_y)
+                FIXME("absolute movement to %d,%d not implemented\n", send->mouse.last_x, send->mouse.last_y);
+        }
+        else
+        {
+            if (send->mouse.last_x) clone_write(node, EV_REL, REL_X, send->mouse.last_x);
+            if (send->mouse.last_y) clone_write(node, EV_REL, REL_Y, send->mouse.last_y);
+        }
+        clone_write(node, EV_SYN, SYN_REPORT, 0);
+        break;
+
+    case RAZER_INPUT_DKM:
+        break;
+
+    case RAZER_INPUT_DISPLAY:
+        TRACE("filter %s display %#x\n", wine_dbgstr_longlong(filter->id), send->raw[0]);
+        if (send->raw[0] == 0x6f) send_key(filter, KEY_BRIGHTNESSUP, TRUE);
+        else if (send->raw[0] == 0x70) send_key(filter, KEY_BRIGHTNESSDOWN, TRUE);
+        else
+        {
+            send_key(filter, KEY_BRIGHTNESSUP, FALSE);
+            send_key(filter, KEY_BRIGHTNESSDOWN, FALSE);
+        }
+        break;
+
+    default:
+        FIXME("filter %s input type %#x not implemented: %s\n", wine_dbgstr_longlong(filter->id), send->type,
+              wine_dbgstr_an((const char *)send->raw, sizeof(send->raw)));
+        break;
+    }
+}
+
+NTSTATUS razer_filter_ioctl(struct razer_ioctl_params *params)
+{
+    struct razer_filter *filter = find_filter(params->filter);
+    const struct razer_input *input = params->in;
+    struct razer_hook_entry *entry;
+    UINT index = 0;
+
+    params->out_len = 0;
+    if (!filter) return STATUS_DEVICE_NOT_CONNECTED;
+
+    switch (params->code)
+    {
+    case RAZER_SET_SUBSCRIPTIONS:
+        if (params->in_size < sizeof(UINT)) return STATUS_INVALID_PARAMETER;
+        TRACE("filter %s subscriptions %#x\n", wine_dbgstr_longlong(filter->id), *(UINT *)params->in);
+        filter->subscriptions = *(UINT *)params->in;
+        filter_update(filter);
+        return STATUS_SUCCESS;
+
+    case RAZER_RESET:
+        /* the last handle is closed; the next client starts from a clean slate, as it
+         * would after a restart */
+        TRACE("filter %s reset\n", wine_dbgstr_longlong(filter->id));
+        filter->subscriptions = 0;
+        filter_clear_hooks(filter);
+        return STATUS_SUCCESS;
+
+    case IOCTL_RAZER_SET_HOOKS_ENABLED:
+        if (params->in_size < 1) return STATUS_INVALID_PARAMETER;
+        filter->hooks_enabled = !!*(BYTE *)params->in;
+        return STATUS_SUCCESS;
+
+    case IOCTL_RAZER_SET_REDIRECT:
+    {
+        const struct razer_redirect *redirect = params->in;
+        if (params->in_size < sizeof(*redirect)) return STATUS_INVALID_PARAMETER;
+        TRACE("filter %s redirect %u %u\n", wine_dbgstr_longlong(filter->id), redirect->type, redirect->enable);
+        if (redirect->type == 1) filter->redirect_keyboard = !!redirect->enable;
+        else if (redirect->type == 2) filter->redirect_mouse = !!redirect->enable;
+        else if (redirect->type == 4)
+        {
+            /* the mapping engine wants pointer movement from Razer's driver below the HID
+             * stack; it goes on to the desktop here regardless */
+            filter->redirect_move = !!redirect->enable;
+            if (redirect->enable) FIXME("redirection of pointer movement not implemented\n");
+        }
+        return STATUS_SUCCESS;
+    }
+
+    case IOCTL_RAZER_SEND_INPUT:
+        if (params->in_size < sizeof(struct razer_send_input)) return STATUS_INVALID_PARAMETER;
+        send_input(filter, params->in);
+        return STATUS_SUCCESS;
+
+    case IOCTL_RAZER_ADD_HOOK:
+        if (params->in_size < sizeof(struct razer_hook)) return STATUS_INVALID_PARAMETER;
+        TRACE("filter %s add hook type %#x unit %#x %s modifiers %#x\n", wine_dbgstr_longlong(filter->id),
+              input->type, input->keyboard.unit_id,
+              input->type == RAZER_INPUT_MOUSE
+              ? wine_dbg_sprintf("buttons %#x data %#x", input->mouse.button_flags, input->mouse.button_data)
+              : wine_dbg_sprintf("make %#x flags %#x", input->keyboard.make_code, input->keyboard.flags),
+              input_modifiers(input));
+        remove_hook(filter, input);
+        if (!(entry = calloc(1, sizeof(*entry)))) return STATUS_NO_MEMORY;
+        memcpy(&entry->hook, params->in, sizeof(entry->hook));
+        list_add_tail(&filter->hooks, &entry->entry);
+        return STATUS_SUCCESS;
+
+    case IOCTL_RAZER_REMOVE_HOOK:
+        if (params->in_size < sizeof(struct razer_input)) return STATUS_INVALID_PARAMETER;
+        TRACE("filter %s remove hook type %#x\n", wine_dbgstr_longlong(filter->id), input->type);
+        remove_hook(filter, input);
+        return STATUS_SUCCESS;
+
+    case IOCTL_RAZER_FIND_HOOK:
+        if (params->in_size < sizeof(struct razer_input) || params->out_size < sizeof(struct razer_hook))
+            return STATUS_INVALID_PARAMETER;
+        LIST_FOR_EACH_ENTRY_REV(entry, &filter->hooks, struct razer_hook_entry, entry)
+        {
+            if (entry->removed || !hook_equal(&entry->hook.input, input)) continue;
+            memcpy(params->out, &entry->hook, sizeof(entry->hook));
+            params->out_len = sizeof(entry->hook);
+            return STATUS_SUCCESS;
+        }
+        return STATUS_UNSUCCESSFUL;
+
+    case IOCTL_RAZER_GET_HOOK:
+        if (params->in_size < sizeof(UINT) || params->out_size < sizeof(struct razer_hook))
+            return STATUS_INVALID_PARAMETER;
+        LIST_FOR_EACH_ENTRY(entry, &filter->hooks, struct razer_hook_entry, entry)
+        {
+            if (entry->removed || index++ != *(UINT *)params->in) continue;
+            memcpy(params->out, &entry->hook, sizeof(entry->hook));
+            params->out_len = sizeof(entry->hook);
+            return STATUS_SUCCESS;
+        }
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    FIXME("filter %s ioctl %#x not implemented\n", wine_dbgstr_longlong(filter->id), params->code);
+    return STATUS_NOT_SUPPORTED;
+}
+
+#else
+
+struct razer_filter *razer_filter_add(struct udev *context, struct udev_device *dev,
+                                      const struct device_desc *desc, struct list *queue)
+{
+    return NULL;
+}
+
+void razer_filter_release(struct razer_filter *filter, struct list *queue)
+{
+}
+
+BOOL razer_filter_read(int fd, struct list *queue)
+{
+    return FALSE;
+}
+
+NTSTATUS razer_filter_ioctl(struct razer_ioctl_params *params)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+void razer_filter_shutdown(void)
+{
+}
+
+#endif
